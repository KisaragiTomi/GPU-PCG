// The surface RoadLab's junction connectors and crosswalks lie on, found on the GPU; CSRoadDecals.h
// builds the items on the CPU, and the network actor draws them as instanced mesh decals at these
// heights (CSRoadDecalInstances.h).
//
// Receivers. A node's RoadSurfaceProjection holds the road triangles RoadRenderer.Add put into it:
// every triangle of the node instances there and the triangles of each edge near the node, keeping
// those facing up (normal y >= .7) with a non-degenerate footprint. ReceiversCS gathers them per
// segment in that insertion order, as references into the road mesh just built; corners and
// normals are read back from its streams (world space, cm) and returned to the network's Unity
// space (m), the space RoadDecals works in. It also boxes each chunk of THREADGROUP_SIZE receiver
// slots, so a gather skips the chunks out of its reach without reading their triangles.
//
// Projection. TryProject's candidates are the receivers registered in the point's 8 m cell, and of
// equally close surfaces the first wins. Each item first gathers, in order, the receivers whose
// footprint can reach its own into groupshared memory (a superset: the barycentric test rejects
// the rest), with their 8 m cells and their xz box in centimetres from the item's corner; a vertex
// reads the corners of only the few whose box holds it. When that list does not fit, a grid
// gathers again for each run of THREADGROUP_SIZE vertices over their own box, as many lists in turn
// as that takes. The result is the same.

#include "CSRoadGeometryCommon.ush"
#include "CSRoadMeshLayout.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSPackedVertex.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 64
#endif

// RoadSurfaceProjection.CellSize.
#define RD_CELL 8.0f
#define RD_MAX_CANDIDATES 1536u
// Cells an item may span per axis and still pack its candidates' cell ranges in 4 bits each.
#define RD_MAX_ITEM_CELLS 16

#define RD_STRIP 0u
#define RD_PROJECTED 1u
#define RD_CLIPPED 2u

// CSRoadDecals.h FGpuDecalItem.
struct FDecalItem
{
	Bezier4x3 Curve;
	float4 Distance;
	float4 UVArea;
	float2 Weights;
	float2 Connected;
	float Length;
	float Width;
	float Lift;
	float Smoothing;
	uint Kind;
	uint Rows;
	uint Receiver;
	uint MaterialSlot;
	uint VertexOffset;
};

// CSRoadDecals.h FGpuReceiverSegment.
struct FReceiverSegment
{
	uint Instance;
	uint Filter;
	uint Offset;
	uint Capacity;
	float3 Centre;
	float Radius2;
	float3 OtherCentre;
	uint bTwoCentres;
};

uint NumSegments;
uint SegmentGroupsX;
StructuredBuffer<FReceiverSegment> Segments;
StructuredBuffer<FMeshInstance> MeshInstances;
// Per receiver node: first segment, segment count.
StructuredBuffer<uint2> ReceiverNodes;
RWStructuredBuffer<uint> ReceiverSlotsRW;
StructuredBuffer<uint> ReceiverSlots;
RWStructuredBuffer<uint> SegmentCountsRW;
StructuredBuffer<uint> SegmentCounts;
// Per chunk of THREADGROUP_SIZE receiver slots (a segment starts on a chunk): the union of its
// receivers' boxes (RD_Box), xz min then max.
RWStructuredBuffer<float4> ChunkBoxesRW;
StructuredBuffer<float4> ChunkBoxes;

// The road mesh streams (world space, cm) and the way back to the network's space.
Buffer<float> RoadPositions;
Buffer<uint> RoadTangents;
Buffer<uint> RoadIndices;
float4x4 WorldToLocal;

uint NumItems;
uint ItemGroupsX;
StructuredBuffer<FDecalItem> Items;
// [0]: runs walking their receivers in memory; [1]: grids gathering per run of vertices.
RWStructuredBuffer<uint> StatsRW;
// Tests: every grid takes the way of a list that does not fit.
uint ForceFallback;
// DecalFitCS's heights (FGpuDecalInput::NumFitHeights).
RWStructuredBuffer<float> FitHeightsRW;

uint RD_GroupIndex(uint3 GroupId, uint GroupsX) { return GroupId.y * GroupsX + GroupId.x; }

// ---------------------------------------------------------------------------------------------
// Group helpers
// ---------------------------------------------------------------------------------------------

groupshared uint RD_Scan[THREADGROUP_SIZE];

// Exclusive prefix of value over the group, in thread order; every thread must call it.
uint RD_ExclusiveScan(uint value, uint GroupIndex, out uint total)
{
	RD_Scan[GroupIndex] = value;
	GroupMemoryBarrierWithGroupSync();
	for (uint offset = 1u; offset < THREADGROUP_SIZE; offset <<= 1)
	{
		uint add = GroupIndex >= offset ? RD_Scan[GroupIndex - offset] : 0u;
		GroupMemoryBarrierWithGroupSync();
		RD_Scan[GroupIndex] += add;
		GroupMemoryBarrierWithGroupSync();
	}
	total = RD_Scan[THREADGROUP_SIZE - 1u];
	uint inclusive = RD_Scan[GroupIndex];
	GroupMemoryBarrierWithGroupSync();
	return inclusive - value;
}

// An xz box (min, then max) that holds nothing.
#define RD_EMPTY_BOX float4(3.0e38f, 3.0e38f, -3.0e38f, -3.0e38f)

groupshared float4 RD_Bounds[THREADGROUP_SIZE];

// The union of the group's xz boxes; every thread must call it.
float4 RD_GroupBox(float4 box, uint GroupIndex)
{
	RD_Bounds[GroupIndex] = box;
	GroupMemoryBarrierWithGroupSync();
	for (uint offset = THREADGROUP_SIZE / 2u; offset > 0u; offset >>= 1)
	{
		if (GroupIndex < offset)
		{
			float4 mine = RD_Bounds[GroupIndex];
			float4 other = RD_Bounds[GroupIndex + offset];
			RD_Bounds[GroupIndex] = float4(min(mine.xy, other.xy), max(mine.zw, other.zw));
		}
		GroupMemoryBarrierWithGroupSync();
	}
	float4 bounds = RD_Bounds[0];
	GroupMemoryBarrierWithGroupSync();
	return bounds;
}

bool RD_BoxesOverlap(float4 box, float2 lo, float2 hi) { return !(any(box.xy > hi) || any(box.zw < lo)); }

// ---------------------------------------------------------------------------------------------
// Receivers
// ---------------------------------------------------------------------------------------------

struct FReceiver
{
	float3 A;
	float3 B;
	float3 C;
};

float3 RD_Position(uint vertex)
{
	float3 world = float3(RoadPositions[vertex * 3u + 0u], RoadPositions[vertex * 3u + 1u], RoadPositions[vertex * 3u + 2u]);
	float3 local = mul(float4(world, 1.0f), WorldToLocal).xyz;
	return float3(local.x, local.z, 0.0f - local.y) / 100.0f;
}

float3 RD_VertexNormal(uint vertex)
{
	float3 world = UnpackSnorm8888(RoadTangents[vertex * 2u + 1u]).xyz;
	float3 local = mul(float4(world, 0.0f), WorldToLocal).xyz;
	return float3(local.x, local.z, 0.0f - local.y);
}

// The road index stream holds a triangle's corners as 0, 2, 1 (UE winding).
FReceiver RD_Receiver(uint tri)
{
	FReceiver r;
	r.A = RD_Position(RoadIndices[tri * 3u + 0u]);
	r.B = RD_Position(RoadIndices[tri * 3u + 2u]);
	r.C = RD_Position(RoadIndices[tri * 3u + 1u]);
	return r;
}

// RoadRenderer.Add: normalizesafe of the corner normals' sum.
float3 RD_ReceiverNormal(uint tri)
{
	float3 a = normalizesafe(RD_VertexNormal(RoadIndices[tri * 3u + 0u]));
	float3 b = normalizesafe(RD_VertexNormal(RoadIndices[tri * 3u + 2u]));
	float3 c = normalizesafe(RD_VertexNormal(RoadIndices[tri * 3u + 1u]));
	return normalizesafe(a + b + c);
}

int2 RD_Cell(float2 xz) { return int2(floor(xz / RD_CELL)); }

// The 8 m cells RoadSurfaceProjection.Add registers a receiver in: x0, z0, x1, z1.
int4 RD_Cells(FReceiver r)
{
	float3 lo = U_min(r.A, U_min(r.B, r.C));
	float3 hi = U_max(r.A, U_max(r.B, r.C));
	return int4(RD_Cell(lo.xz), RD_Cell(hi.xz));
}

// A receiver's xz box widened by more than the barycentric slack TryProject allows
// (s, r >= -.0005, s + r <= 1.0005): no point outside it can land on the receiver.
void RD_Box(FReceiver r, out float2 lo, out float2 hi)
{
	lo = U_min(r.A.xz, U_min(r.B.xz, r.C.xz));
	hi = U_max(r.A.xz, U_max(r.B.xz, r.C.xz));
	float margin = 0.002f * cmax(hi - lo) + 0.001f;
	lo -= margin;
	hi += margin;
}

// RoadRenderer.Add's choice for one segment, then RoadSurfaceProjection.Add's filter.
bool RD_Receives(FReceiverSegment s, uint tri)
{
	FReceiver r = RD_Receiver(tri);
	if (s.Filter == 1u)
	{
		bool bNear = U_min(distancesq(r.A.xz, s.Centre.xz), U_min(distancesq(r.B.xz, s.Centre.xz), distancesq(r.C.xz, s.Centre.xz))) < s.Radius2;
		if (s.bTwoCentres != 0u) bNear = bNear || U_min(distancesq(r.A.xz, s.OtherCentre.xz), U_min(distancesq(r.B.xz, s.OtherCentre.xz), distancesq(r.C.xz, s.OtherCentre.xz))) < s.Radius2;
		if (!bNear) return false;
	}
	if (RD_ReceiverNormal(tri).y < 0.7f) return false;
	return !(abs((r.B.x - r.A.x) * (r.C.z - r.A.z) - (r.B.z - r.A.z) * (r.C.x - r.A.x)) < 1e-8f);
}

// One group per segment: the instance's triangles that land in the node's projection, in order,
// then the box of each chunk of them.
[numthreads(THREADGROUP_SIZE, 1, 1)]
void ReceiversCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	uint segmentIndex = RD_GroupIndex(GroupId, SegmentGroupsX);
	if (segmentIndex >= NumSegments) return;
	FReceiverSegment s = Segments[segmentIndex];
	uint first = MeshInstances[s.Instance].IndexOffset / 3u;
	uint count = 0u;
	for (uint start = 0u; start < s.Capacity; start += THREADGROUP_SIZE)
	{
		uint t = start + GroupIndex;
		bool bKeep = t < s.Capacity && RD_Receives(s, first + t);
		uint total;
		uint rank = RD_ExclusiveScan(bKeep ? 1u : 0u, GroupIndex, total);
		if (bKeep) ReceiverSlotsRW[s.Offset + count + rank] = first + t;
		count += total;
	}
	if (GroupIndex == 0u) SegmentCountsRW[segmentIndex] = count;
	DeviceMemoryBarrierWithGroupSync();
	for (uint chunk = 0u; chunk < count; chunk += THREADGROUP_SIZE)
	{
		float4 box = RD_EMPTY_BOX;
		if (chunk + GroupIndex < count)
		{
			float2 lo, hi;
			RD_Box(RD_Receiver(ReceiverSlotsRW[s.Offset + chunk + GroupIndex]), lo, hi);
			box = float4(lo, hi);
		}
		box = RD_GroupBox(box, GroupIndex);
		if (GroupIndex == 0u) ChunkBoxesRW[(s.Offset + chunk) / THREADGROUP_SIZE] = box;
	}
}

// ---------------------------------------------------------------------------------------------
// An item's candidates
// ---------------------------------------------------------------------------------------------

groupshared uint RD_Candidates[RD_MAX_CANDIDATES];
// Cell range relative to the item's first cell, 4 bits each: x0, z0, x1, z1 (clamped to the item).
groupshared uint RD_CandidateCells[RD_MAX_CANDIDATES];
// Box (with the barycentric slack) in cm from the area's corner, x | z << 16, rounded outward.
groupshared uint RD_CandidateLo[RD_MAX_CANDIDATES];
groupshared uint RD_CandidateHi[RD_MAX_CANDIDATES];
groupshared uint RD_CandidateCount;
groupshared uint RD_bInMemory;
// Where a full list stopped: the first receiver (in its segment) that did not fit.
groupshared uint RD_Resume;

// The xz box an item's vertices stay in and its first 8 m cell.
struct FItemArea
{
	float2 Min;
	float2 Max;
	int2 BaseCell;
};

FItemArea RD_MakeArea(float2 lo, float2 hi)
{
	FItemArea area;
	area.Min = lo;
	area.Max = hi;
	area.BaseCell = RD_Cell(lo);
	return area;
}

// The area of the group's xz boxes, widened by a centimetre; every thread must call it.
FItemArea RD_GroupArea(float4 box, uint GroupIndex)
{
	float4 bounds = RD_GroupBox(box, GroupIndex);
	return RD_MakeArea(bounds.xy - 0.01f, bounds.zw + 0.01f);
}

// Too many 8 m cells to pack a candidate's cell range, or too wide for its box in 16 bit cm.
bool RD_IsWide(FItemArea area)
{
	return any(RD_Cell(area.Max) - area.BaseCell >= RD_MAX_ITEM_CELLS) || any((area.Max - area.Min) * 100.0f > 65000.0f);
}

// The area-relative box in cm, rounded outward and clamped to 16 bits.
uint RD_PackLow(float2 lo, FItemArea area) { uint2 c = uint2(clamp(floor((lo - area.Min) * 100.0f) - 1.0f, 0.0f, 65535.0f)); return c.x | (c.y << 16); }
uint RD_PackHigh(float2 hi, FItemArea area) { uint2 c = uint2(clamp(ceil((hi - area.Min) * 100.0f) + 1.0f, 0.0f, 65535.0f)); return c.x | (c.y << 16); }

// Whether a packed box can overlap the area-relative box [lo, hi] (cm).
bool RD_BoxOverlaps(uint packedLo, uint packedHi, float2 lo, float2 hi)
{
	return float(packedLo & 0xFFFFu) <= hi.x && float(packedLo >> 16) <= hi.y && float(packedHi & 0xFFFFu) >= lo.x && float(packedHi >> 16) >= lo.y;
}

uint RD_PackCells(int4 cells, int2 base)
{
	int4 relative = clamp(cells - base.xyxy, 0, RD_MAX_ITEM_CELLS - 1);
	return uint(relative.x) | (uint(relative.y) << 4) | (uint(relative.z) << 8) | (uint(relative.w) << 12);
}

int4 RD_UnpackCells(uint packed, int2 base)
{
	return int4(int(packed & 15u), int((packed >> 4) & 15u), int((packed >> 8) & 15u), int((packed >> 12) & 15u)) + base.xyxy;
}

// Fills the candidate list, in order, with the node's receivers from cursor (segment, receiver in
// it) on whose box can reach the area, which must not be wide; every thread must call it. When the
// list fills up, cursor is left at the first receiver that did not fit and true is returned.
bool RD_GatherBlock(uint node, FItemArea area, uint GroupIndex, inout uint2 cursor)
{
	uint2 segments = ReceiverNodes[node];
	uint count = 0u;
	bool bFull = false;
	while (cursor.x < segments.y && !bFull)
	{
		FReceiverSegment s = Segments[segments.x + cursor.x];
		uint received = SegmentCounts[segments.x + cursor.x];
		while (cursor.y < received)
		{
			// One chunk at a time, from the cursor on.
			uint from = cursor.y;
			uint start = from - from % THREADGROUP_SIZE;
			cursor.y = start + THREADGROUP_SIZE;
			if (!RD_BoxesOverlap(ChunkBoxes[(s.Offset + start) / THREADGROUP_SIZE], area.Min, area.Max)) continue;
			uint i = start + GroupIndex;
			bool bTake = false;
			uint tri = 0u;
			uint packed = 0u;
			uint packedLo = 0u;
			uint packedHi = 0u;
			if (i >= from && i < received)
			{
				tri = ReceiverSlots[s.Offset + i];
				FReceiver r = RD_Receiver(tri);
				float2 lo, hi;
				RD_Box(r, lo, hi);
				bTake = all(lo <= area.Max) && all(hi >= area.Min);
				packed = RD_PackCells(RD_Cells(r), area.BaseCell);
				packedLo = RD_PackLow(lo, area);
				packedHi = RD_PackHigh(hi, area);
			}
			uint total;
			uint slot = count + RD_ExclusiveScan(bTake ? 1u : 0u, GroupIndex, total);
			if (bTake && slot < RD_MAX_CANDIDATES)
			{
				RD_Candidates[slot] = tri;
				RD_CandidateCells[slot] = packed;
				RD_CandidateLo[slot] = packedLo;
				RD_CandidateHi[slot] = packedHi;
			}
			if (bTake && slot == RD_MAX_CANDIDATES) RD_Resume = i;
			if (count + total > RD_MAX_CANDIDATES)
			{
				GroupMemoryBarrierWithGroupSync();
				cursor.y = RD_Resume;
				count = RD_MAX_CANDIDATES;
				bFull = true;
				break;
			}
			count += total;
		}
		if (!bFull)
		{
			cursor.x++;
			cursor.y = 0u;
		}
	}
	if (GroupIndex == 0u)
	{
		RD_CandidateCount = count;
		RD_bInMemory = 0u;
	}
	GroupMemoryBarrierWithGroupSync();
	return bFull;
}

// Makes the candidates the node's receivers, read in memory; every thread must call it.
void RD_WalkInMemory(uint node, uint GroupIndex)
{
	if (GroupIndex == 0u)
	{
		uint2 segments = ReceiverNodes[node];
		uint all = 0u;
		for (uint k = 0u; k < segments.y; k++) all += SegmentCounts[segments.x + k];
		RD_bInMemory = 1u;
		RD_CandidateCount = all;
		InterlockedAdd(StatsRW[0], 1u);
	}
	GroupMemoryBarrierWithGroupSync();
}

// The area's candidates in one list; every thread must call it. False when they do not fit or the
// area is too wide (the list is then unusable).
bool RD_GatherCandidates(uint node, FItemArea area, uint GroupIndex)
{
	if (RD_IsWide(area)) return false;
	uint2 cursor = uint2(0u, 0u);
	return !RD_GatherBlock(node, area, GroupIndex, cursor);
}

// The next of the lists a run's candidates take (true while more follow); a wide area walks the
// receivers in memory instead.
bool RD_GatherRun(uint node, FItemArea area, uint GroupIndex, inout uint2 cursor)
{
	if (!RD_IsWide(area)) return RD_GatherBlock(node, area, GroupIndex, cursor);
	RD_WalkInMemory(node, GroupIndex);
	return false;
}

// Candidate i: its triangle and absolute 8 m cell range.
void RD_Candidate(uint node, uint i, FItemArea area, out uint tri, out int4 cells)
{
	if (RD_bInMemory == 0u)
	{
		tri = RD_Candidates[i];
		cells = RD_UnpackCells(RD_CandidateCells[i], area.BaseCell);
		return;
	}
	uint2 segments = ReceiverNodes[node];
	uint k = 0u;
	for (; k + 1u < segments.y && i >= SegmentCounts[segments.x + k]; k++) i -= SegmentCounts[segments.x + k];
	tri = ReceiverSlots[Segments[segments.x + k].Offset + i];
	cells = RD_Cells(RD_Receiver(tri));
}

bool RD_InCells(int4 cells, int2 cell) { return all(cell >= cells.xy) && all(cell <= cells.zw); }

// TryProject's choice so far for one point, carried from one candidate list to the next.
struct FProjection
{
	float Nearest;
	float Y;
	uint Best;
	uint bFound;
};

FProjection RD_StartProjection(float3 pt)
{
	FProjection state;
	state.Nearest = 2.0f;
	state.Y = pt.y;
	state.Best = 0u;
	state.bFound = 0u;
	return state;
}

// RoadSurfaceProjection.TryProject over the current candidate list (gathered for the area): of the
// receivers registered in the point's cell that contain it in xz, the one closest to it in height,
// within 2 m.
void RD_ProjectOver(uint node, float3 pt, FItemArea area, inout FProjection state)
{
	int2 cell = RD_Cell(pt.xz);
	float2 q = (pt.xz - area.Min) * 100.0f;
	for (uint i = 0u; i < RD_CandidateCount; i++)
	{
		if (RD_bInMemory == 0u && !RD_BoxOverlaps(RD_CandidateLo[i], RD_CandidateHi[i], q, q)) continue;
		uint tri;
		int4 cells;
		RD_Candidate(node, i, area, tri, cells);
		if (!RD_InCells(cells, cell)) continue;
		FReceiver t = RD_Receiver(tri);
		float2 u = t.B.xz - t.A.xz;
		float2 v = t.C.xz - t.A.xz;
		float2 p = pt.xz - t.A.xz;
		float d = u.x * v.y - u.y * v.x;
		float s = (p.x * v.y - p.y * v.x) / d;
		float r = (u.x * p.y - u.y * p.x) / d;
		if (s < -0.0005f || r < -0.0005f || s + r > 1.0005f) continue;
		float h = t.A.y + s * (t.B.y - t.A.y) + r * (t.C.y - t.A.y);
		float delta = abs(h - pt.y);
		if (delta >= state.Nearest) continue;
		state.Nearest = delta;
		state.Y = h;
		state.Best = tri;
		state.bFound = 1u;
	}
}

bool RD_TryProject(uint node, float3 pt, FItemArea area, out float y, out uint best)
{
	FProjection state = RD_StartProjection(pt);
	RD_ProjectOver(node, pt, area, state);
	y = state.Y;
	best = state.Best;
	return state.bFound != 0u;
}

// ---------------------------------------------------------------------------------------------
// Fitted grids (the network actor's instanced decals, CSRoadDecalInstances.h)
// ---------------------------------------------------------------------------------------------

// Columns of a fitted grid (FGpuDecalInput::FitColumns): a projected grid's.
#define RD_FIT_COLUMNS 6u

// One group per item; strips have none. The heights TryProject lands the item's grid on (Unity
// metres, NaN where no receiver takes a vertex), Rows + 1 rows of RD_FIT_COLUMNS + 1 from
// VertexOffset on. A junction connector's grid is the one RoadDecals.AddLane projects, vertex for
// vertex; a crosswalk's spans the footprint AddLane(clipToSurface) clips to the surface, straight
// between its curve's ends, each vertex taking the receiver closest to the footprint's height there.
[numthreads(THREADGROUP_SIZE, 1, 1)]
void DecalFitCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	uint itemIndex = RD_GroupIndex(GroupId, ItemGroupsX);
	if (itemIndex >= NumItems) return;
	FDecalItem item = Items[itemIndex];
	if (item.Kind == RD_STRIP) return;
	bool bClip = item.Kind == RD_CLIPPED;
	uint stride = RD_FIT_COLUMNS + 1u;
	uint count = item.Rows;
	uint numVertices = (count + 1u) * stride;

	float3 a = item.Curve.a;
	float3 dd = item.Curve.d;
	float3 side = normalizesafe(float3(dd.z - a.z, 0.0f, a.x - dd.x));
	float2 lo;
	float2 hi;
	if (bClip)
	{
		float3 reach = side * item.Width * 0.5f;
		lo = U_min(U_min((a - reach).xz, (a + reach).xz), U_min((dd - reach).xz, (dd + reach).xz)) - 0.01f;
		hi = U_max(U_max((a - reach).xz, (a + reach).xz), U_max((dd - reach).xz, (dd + reach).xz)) + 0.01f;
	}
	else
	{
		lo = U_min(U_min(item.Curve.a.xz, item.Curve.b.xz), U_min(item.Curve.c.xz, item.Curve.d.xz)) - item.Width * 0.5f - 0.01f;
		hi = U_max(U_max(item.Curve.a.xz, item.Curve.b.xz), U_max(item.Curve.c.xz, item.Curve.d.xz)) + item.Width * 0.5f + 0.01f;
	}
	FItemArea area = RD_MakeArea(lo, hi);
	bool bPerRun = !RD_GatherCandidates(item.Receiver, area, GroupIndex) || ForceFallback != 0u;
	if (bPerRun && GroupIndex == 0u) InterlockedAdd(StatsRW[1], 1u);

	for (uint start = 0u; start < numVertices; start += THREADGROUP_SIZE)
	{
		uint vertex = start + GroupIndex;
		bool bActive = vertex < numVertices;
		uint i = min(vertex, numVertices - 1u) / stride;
		uint column = vertex % stride;
		float t = float(i) / float(count);
		float across = float(column) / float(RD_FIT_COLUMNS);
		precise float3 position;
		if (bClip)
		{
			position = U_lerp(a, dd, t) + side * ((across - 0.5f) * item.Width);
		}
		else
		{
			// RoadDecals.AddLane's grid vertex.
			precise float3 p = MU_Position(item.Curve, t);
			precise float3 tangent = normalizesafe(MU_Tangent(item.Curve, t));
			float3 right = float3(tangent.z, 0.0f, 0.0f - tangent.x);
			position = p + right * (across - 0.5f) * item.Width;
		}
		FProjection state = RD_StartProjection(position);
		if (!bPerRun)
		{
			if (bActive) RD_ProjectOver(item.Receiver, position, area, state);
		}
		else
		{
			FItemArea run = RD_GroupArea(bActive ? float4(position.xz, position.xz) : RD_EMPTY_BOX, GroupIndex);
			uint2 cursor = uint2(0u, 0u);
			bool bMore = true;
			while (bMore)
			{
				bMore = RD_GatherRun(item.Receiver, run, GroupIndex, cursor);
				if (bActive) RD_ProjectOver(item.Receiver, position, run, state);
				GroupMemoryBarrierWithGroupSync();
			}
		}
		if (bActive) FitHeightsRW[item.VertexOffset + vertex] = state.bFound != 0u ? state.Y : asfloat(0x7FC00000u);
	}
}
