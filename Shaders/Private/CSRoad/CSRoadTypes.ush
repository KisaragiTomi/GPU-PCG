	Bounds1 m_DefaultSurfaceHeight;
	Bounds1 m_EdgeLengthRange;
	uint m_MergeLayers;
	uint m_IntersectLayers;
	uint m_Flags;
	float m_DefaultWidth;
	float m_ElevatedWidth;
	float m_ElevatedLength;
	float m_MinNodeOffset;
	float m_ElevationLimit;
	float m_MaxSlopeSteepness;
	float m_Hanging;
};

struct NetData
{
	uint m_RequiredLayers;
	uint m_ConnectLayers;
	uint m_LocalConnectLayers;
	uint m_GeneralFlagMask;
	uint m_SideFlagMask;
	float m_NodePriority;
};

struct RoadData
{
	int m_ZoneBlockPrefab;
	float m_SpeedLimit;
	uint m_Flags;
};

struct PlaceableNetData
{
	Bounds1 m_ElevationRange;
	int m_UndergroundPrefab;
	uint m_PlacementFlags;
	CompositionFlags m_SetUpgradeFlags;
	CompositionFlags m_UnsetUpgradeFlags;
	uint m_DefaultConstructionCost;
	float m_DefaultUpkeepCost;
	float m_SnapDistance;
	float m_MinWaterElevation;
	int m_XPReward;
};

struct NetLaneData
{
	int m_PathfindPrefab;
	uint m_Flags;
	float m_Width;
};

struct NetPieceData
{
	Bounds1 m_HeightRange;
	float4 m_SurfaceHeights;
	float m_Width;
	float m_Length;
	float m_WidthOffset;
	float m_NodeOffset;
	float m_SideConnectionOffset;
};

struct NetPieceLane
{
	int m_Lane;
	float3 m_Position;
	uint m_ExtraFlags;
};

struct NetVertexMatchData
{
	float3 m_Offsets;
};

struct NetCrosswalkData
{
	int m_Lane;
	float3 m_Start;
	float3 m_End;
};

struct NetSubSection
{
	int m_SubSection;
	CompositionFlags m_CompositionAll;
	CompositionFlags m_CompositionAny;
	CompositionFlags m_CompositionNone;
	uint m_SectionAll;
	uint m_SectionAny;
	uint m_SectionNone;
};

struct NetSectionPiece
{
	int m_Piece;
	CompositionFlags m_CompositionAll;
	CompositionFlags m_CompositionAny;
	CompositionFlags m_CompositionNone;
	uint m_SectionAll;
	uint m_SectionAny;
	uint m_SectionNone;
	uint m_Flags;
	float3 m_Offset;
};

struct NetGeometrySection
{
	int m_Section;
	CompositionFlags m_CompositionAll;
	CompositionFlags m_CompositionAny;
	CompositionFlags m_CompositionNone;
	uint m_Flags;
	float3 m_Offset;
};

struct NetGeometryEdgeState
{
	CompositionFlags m_CompositionAll;
	CompositionFlags m_CompositionAny;
	CompositionFlags m_CompositionNone;
	CompositionFlags m_State;
};

struct NetGeometryNodeState
{
	CompositionFlags m_CompositionAll;
	CompositionFlags m_CompositionAny;
	CompositionFlags m_CompositionNone;
	CompositionFlags m_State;
	uint m_MatchType;
};

struct MeshMaterial
{
	int m_StartIndex;
	int m_IndexCount;
	int m_StartVertex;
	int m_VertexCount;
	int m_MaterialIndex;
};

struct GeometrySystem_EdgeData
{
	float3 m_Left;
	float3 m_Right;
	uint m_Layers;
	int m_Entity;
	float2 m_Changes;
	float m_MaxSlope;
	uint m_IsEnd;
	uint m_IsTemp;
};

struct GeometrySystem_IntersectionData
{
	Bezier4x3 m_StartMiddle;
	Bezier4x3 m_EndMiddle;
	Bounds3 m_StartBounds;
	Bounds3 m_EndBounds;
};

struct CompositionParameters
{
	Float3x4 m_TransformMatrix;
	Float4x4 m_CompositionMatrix0;
	Float4x4 m_CompositionMatrix1;
	Float4x4 m_CompositionMatrix2;
	Float4x4 m_CompositionMatrix3;
	Float4x4 m_CompositionMatrix4;
	Float4x4 m_CompositionMatrix5;
	Float4x4 m_CompositionMatrix6;
	Float4x4 m_CompositionMatrix7;
	float4 m_CompositionSync0;
	float4 m_CompositionSync1;
	float4 m_CompositionSync2;
	float4 m_CompositionSync3;
};

