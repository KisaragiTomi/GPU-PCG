// 把一组 GPU 常驻的点（float4 位置 + float4 法线）展开成箭头网格，写进
// LocalVertexFactory 的标准 stream 集（位置 / 打包切线基 / UV / 顶点色）+ 索引缓冲 +
// DrawIndexedIndirect args。切线与颜色流按 CSPackedVertex.ush 打包，与 CSMeshOps.usf / RoadBuilder.usf
// 相同，因此共用 FCSGpuMeshSceneProxy 的同一条绘制路径。
//
// 一个箭头 = 方形柱身（4 个侧面）+ 四棱锥头，沿该点法线朝向：位置与方向由同一个形状表达，
// 不再需要"点 + 单独的方向线"两次绘制。
//
// 每个箭头固定 13 顶点 / 14 三角（42 索引）：
//   顶点  0..3   柱身底部四角
//   顶点  4..7   柱身顶部四角（= 锥体底面）
//   顶点  8      锥尖
//   顶点  9..12  锥体底面（独立一份，便于给锥面单独的法线）
// 数量固定，故 CPU 侧能直接按 PointCount 算容量，无需回读。
// 位置为世界空间；宿主组件以绝对变换渲染，这里不做局部/世界转换。

#include "/Engine/Public/Platform.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSPackedVertex.ush"

Buffer<float4> InPositions;  // xyz = 世界位置
Buffer<float4> InNormals;    // xyz = 世界法线（箭头指向）
Buffer<uint>   InCounter;    // InCounter[0] = 有效点数

RWBuffer<float> RWPositions;    // 3 floats / vertex
RWBuffer<uint>  RWTangents;     // 2 packed 8888 SNORM / vertex (TangentX, TangentZ)
RWBuffer<float> RWTexCoords;    // 2 floats / vertex
RWBuffer<uint>  RWColors;       // 1 packed RGBA8 / vertex
RWBuffer<uint>  RWIndices;
RWBuffer<uint>  RWIndirectArgs; // DrawIndexedIndirect: 5 uints
RWBuffer<uint>  RWMeshCounters; // [0] = vertexCount, [1] = indexCount

uint  MaxArrows;      // 容量（本次 dispatch 的上限）
float ArrowLength;    // 箭头总长（沿法线）
float ShaftRadius;    // 柱身"半径"（方形截面的半边长）
float HeadRadius;     // 锥体底面半径
float HeadFraction;   // 锥头占总长的比例 [0,1]
uint  ArrowColor;     // 打包 RGBA8

#define ARROW_VERTS   13u
#define ARROW_TRIS    14u
#define ARROW_INDICES (ARROW_TRIS * 3u)

void WriteVertex(uint V, float3 P, float3 N, float3 TanX, float2 UV)
{
	N = normalize(N);
	if (!all(isfinite(N))) N = float3(0.0f, 0.0f, 1.0f);
	if (!all(isfinite(TanX)) || length(TanX) < 1e-4f) TanX = float3(1.0f, 0.0f, 0.0f);
	TanX = normalize(TanX - N * dot(N, TanX)); // 正交化，避免退化切线基
	if (!all(isfinite(TanX))) TanX = float3(1.0f, 0.0f, 0.0f);

	RWPositions[V * 3 + 0] = P.x;
	RWPositions[V * 3 + 1] = P.y;
	RWPositions[V * 3 + 2] = P.z;
	RWTangents[V * 2 + 0] = PackSnorm8888(float4(TanX, 0.0f));
	RWTangents[V * 2 + 1] = PackSnorm8888(float4(N, 1.0f));
	RWTexCoords[V * 2 + 0] = UV.x;
	RWTexCoords[V * 2 + 1] = UV.y;
	RWColors[V] = ArrowColor;
}

[numthreads(64, 1, 1)]
void BuildPointArrowsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint A = Id.x;
	if (A >= MaxArrows) return;

	const uint VBase = A * ARROW_VERTS;
	const uint IBase = A * ARROW_INDICES;
	const uint ValidCount = InCounter[0];

	// 超出有效点数的槽位：写退化几何（全部塌到同一点），索引照常写，
	// 这样 indirect args 只按有效数绘制时不会读到未初始化内存。
	if (A >= ValidCount)
	{
		for (uint v = 0; v < ARROW_VERTS; ++v)
			WriteVertex(VBase + v, float3(0, 0, 0), float3(0, 0, 1), float3(1, 0, 0), float2(0, 0));
		for (uint i = 0; i < ARROW_INDICES; ++i)
			RWIndices[IBase + i] = VBase;
		return;
	}

	const float3 P = InPositions[A].xyz;
	float3 N = InNormals[A].xyz;
	N = normalize(N);
	if (!all(isfinite(N))) N = float3(0.0f, 0.0f, 1.0f);

	// 法线周围的正交基
	const float3 Helper = (abs(N.z) < 0.99f) ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	float3 U = normalize(cross(Helper, N));
	if (!all(isfinite(U))) U = float3(1.0f, 0.0f, 0.0f);
	const float3 W = cross(N, U);

	const float HeadLen = clamp(HeadFraction, 0.05f, 0.95f) * ArrowLength;
	const float ShaftLen = ArrowLength - HeadLen;
	const float3 ShaftTop = P + N * ShaftLen;
	const float3 Tip = P + N * ArrowLength;

	// --- 柱身：底部 4 角 (0..3)、顶部 4 角 (4..7)
	const float2 Corner[4] = { float2(1, 1), float2(-1, 1), float2(-1, -1), float2(1, -1) };
	for (uint c = 0; c < 4; ++c)
	{
		const float3 Offset = U * (Corner[c].x * ShaftRadius) + W * (Corner[c].y * ShaftRadius);
		const float3 SideN = normalize(Offset);
		WriteVertex(VBase + c,     P + Offset,        SideN, N, float2(float(c) * 0.25f, 0.0f));
		WriteVertex(VBase + 4 + c, ShaftTop + Offset, SideN, N, float2(float(c) * 0.25f, 1.0f));
	}

	// --- 锥头：锥尖 (8)、锥底 4 角 (9..12)
	WriteVertex(VBase + 8, Tip, N, U, float2(0.5f, 1.0f));
	for (uint h = 0; h < 4; ++h)
	{
		const float3 Offset = U * (Corner[h].x * HeadRadius) + W * (Corner[h].y * HeadRadius);
		// 锥面法线：底缘朝外并带一点沿轴分量，近似圆锥侧面
		const float3 ConeN = normalize(normalize(Offset) * HeadLen + N * HeadRadius);
		WriteVertex(VBase + 9 + h, ShaftTop + Offset, ConeN, N, float2(float(h) * 0.25f, 0.0f));
	}

	// --- 索引：柱身 4 个侧面（8 三角）+ 锥体 4 个侧面（4 三角）+ 锥底封口（2 三角）
	uint I = IBase;
	for (uint s = 0; s < 4; ++s)
	{
		const uint s0 = VBase + s;
		const uint s1 = VBase + ((s + 1) % 4);
		const uint t0 = VBase + 4 + s;
		const uint t1 = VBase + 4 + ((s + 1) % 4);
		RWIndices[I++] = s0; RWIndices[I++] = t0; RWIndices[I++] = t1;
		RWIndices[I++] = s0; RWIndices[I++] = t1; RWIndices[I++] = s1;
	}
	for (uint k = 0; k < 4; ++k)
	{
		const uint b0 = VBase + 9 + k;
		const uint b1 = VBase + 9 + ((k + 1) % 4);
		RWIndices[I++] = b0; RWIndices[I++] = VBase + 8; RWIndices[I++] = b1;
	}
	// 锥底封口，避免从下方看穿
	RWIndices[I++] = VBase + 9; RWIndices[I++] = VBase + 11; RWIndices[I++] = VBase + 10;
	RWIndices[I++] = VBase + 9; RWIndices[I++] = VBase + 12; RWIndices[I++] = VBase + 11;
}

[numthreads(1, 1, 1)]
void BuildPointArrowArgsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint ArrowCount = min(InCounter[0], MaxArrows);
	const uint IndexCount = ArrowCount * ARROW_INDICES;
	const uint VertexCount = ArrowCount * ARROW_VERTS;

	RWIndirectArgs[0] = IndexCount; // IndexCountPerInstance
	RWIndirectArgs[1] = 1;          // InstanceCount
	RWIndirectArgs[2] = 0;          // StartIndexLocation
	RWIndirectArgs[3] = 0;          // BaseVertexLocation
	RWIndirectArgs[4] = 0;          // StartInstanceLocation

	RWMeshCounters[0] = VertexCount;
	RWMeshCounters[1] = IndexCount;
}
