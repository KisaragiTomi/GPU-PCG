// 地被（草 + 花）：100% GPU 散布 + 零回读，形状照 Tiny Glade 的 `_generate_grass.cs` +
// `_grass.raster` 那条链（见 Docs/TinyGlade 的对照）。
//
// **一线程 = 一株**。散布格是"抖动网格"（stratified / jittered grid）：一格出一株，落点是
// 格心加一个由**格身份**哈希出来的抖动。这与 TG 用低差异序列在 tile 内撒点是同一件事的
// 简化版 —— 两者要的都是同一条性质：**均匀但不成簇**。纯随机撒点会自发扎堆并留下空洞，
// 抖动网格从构造上就杜绝了这两样，而且不需要前缀和/bundle 那一整套（TG 需要它是因为它
// 每帧重算并要做 tile 级 HZB 剔除，本项目是"地面变了才重扫"，剔除交给实例组件自己的 pass）。
//
// ⚠️ **随机源永远是格身份，绝不是 `InterlockedAdd` 的槽位**（石阶 S1 栽过的那一枪，
// `CSGroundStairs.usf:CSStairs_CellSeed` 的注释里有完整现场）：槽位由线程组完成顺序决定，
// 同一份世界状态两次 dispatch 能把同一株草放进不同的槽。而本 pass 是**每一笔落笔都重扫**的
// （FlushPaintToGpu → RebuildGroundCover），拿槽位当种子的症状就是"画一笔路，整片草原地重掷"，
// 而且不会有任何断言报红。格身份则只在"这一格还长不长草"真的变化时才变。
//
// 同一个 kernel 被**每个物种各 dispatch 一次**（草一次，每种花各一次），物种之间只差
// uniform：格距（= 密度）、抽签概率、遮罩阈值、缩放范围、盐。不为花另写一个 kernel 的理由与
// 石子跟着石阶走同一份代码相同 —— 分两份的话，将来只有一份会跟着 packed 行布局改，
// 而漂掉的那份不报错、只是安静地画出垃圾。
//
// packed 行布局照抄 CSGpuInstancedMesh.usf（那份才是权威，石阶/门框砖/裙边摆件都用它）：
//   前三行 = 被缩放过的基，第 4 行 = 原点 + 每实例随机数，第 5 行 = 剔除球。
// 基的约定：+Z 是株的"上"（受 CoverAlignToNormal 控制在世界上 ↔ 地形法线之间插值），
// **+Y 是株的朝向**（= 基础网格的弯曲方向，也是倾倒方向），+X = Y × Z。
//
// ⚠️ **位置不成簇，朝向成簇** —— 两件事别混：撒点仍是分层抖动网格（均匀、不扎堆），
// 但**朝向**照 TG 走一层 2.5 m 的簇结构（见下面 `CoverClumpSize` 那一段）。
// 花另有一道可选的「聚散」（`CoverPatchSize`，2026-09-29）：那是**密度**随位置成片变化，
// 片内仍是均匀抖动网格，不是让点扎堆。
// TG 的草看起来"朝向丰富"正是这个：全随机读成噪声，全对齐读成梳过的地毯，成簇才像草。

#include "/Engine/Public/Platform.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSGroundShaperField.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSGpuSharedLayout.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSGroundMaskWarp.ush"

#ifndef THREADGROUPSIZE_X
#define THREADGROUPSIZE_X 8
#endif
#ifndef THREADGROUPSIZE_Y
#define THREADGROUPSIZE_Y 8
#endif

// `Platform.ush` 里**没有** `PI`（那是 `Common.ush` 的，而 Common.ush 不能在 global shader
// 里随便 include）。自己写一个常数比 include 一堆渲染管线头文件便宜得多。
#define CSCOVER_TWO_PI 6.28318530717958647692f

Buffer<uint> CoverGroundColors;      // 地面常驻色流，packed BGRA / 顶点，V = Y * VertsX + X

RWBuffer<float4> RWCoverInstances;   // 5 个 float4 / 实例
RWBuffer<uint>   RWCoverCounter;     // [0] = 活跃实例数（只有 GPU 知道这个数）

float4x4 CoverWorldToComponent;

float2 CoverGridOriginXY;            // 散布格 (0,0) 角的世界 XY（整张网格的角，窗口散布也不变）
float  CoverCellSize;                // 格边长 = 1/√密度（CPU 侧换算，见 CSGroundCover.cpp）
uint2  CoverGridDims;                // 这一趟派的**格数**：整张网格，或近处窗口（2026-09-22 地被近 / 远两档）
// 窗口在整张网格里的起始格号。**随机源用整张网格里的格号**，不用窗口内下标 —— 窗口跟着相机挪时，
// 同一格的草一株不变（只有窗口边缘进出的那一圈换人，而那一圈恒在近处画距之外）。整张网格散布恒 (0,0)。
int2   CoverCellOffset;
uint2  CoverGlobalDims;              // 整张网格的格数：窗口伸出地面的那一截格直接退掉

float2 CoverGroundOriginXY;          // 地面镜像格点 (0,0) 的世界 XY —— 取遮罩用
float  CoverGroundCellSize;
uint2  CoverGroundVerts;
float  CoverGroundBaseZ;             // 地面 actor 的世界 Z

// --- 遮罩：地面遮罩（默认），或地面顶点色的某一个通道 ----------------------------
//
// 一律读 **GPU** 上的那一份而不是让 CPU 上传一份镜像拷贝，理由同石阶：地面遮罩是从笔刷双写出来的
// 色流现算的（同一条渲染命令 FIFO），读它意味着"画面上看到的路"与"这里长不长草"构造上同源。
// 上传一份拷贝是第三条路，迟早与另外两条错开一帧，而症状（草比路慢一笔）只在快速涂抹时才看得见。
float4 CoverMaskChannel;             // one-hot，与色流 dot；默认 (1,0,0,0) = R = 道路权重
float  CoverMaskStart;               // 遮罩值 ≤ Start：完全不受抑制
float  CoverMaskEnd;                 // 遮罩值 ≥ End：完全长不出来
float  CoverMaskShorten;             // 遮罩值 → 高度压缩比例（TG 在路上把草高压到 0.3 倍）

// --- 地面遮罩（2026-09-29 用户："地形 mask 决定草；经过处理的地面 mask 作为地面 mesh 的遮罩控制贴图"）---
//
// 笔刷画的路权重是逐顶点的，一格 50 cm 之内就从 0 跳到 1。地面 actor 先把它处理成一张**地面遮罩**
// 贴图（`ACSGroundActor::GroundMask`：平滑 + 向外延伸，`CSGroundRoadField.usf`），地面材质用它混
// 土路 / 深土 / 草地三层贴图，这里的拒绝、压矮、弯曲也全读它 —— 贴图上是土的地方就不长草，
// 两边构造上同源，不会再出现"草在路缘满高一刀切、土路边却是另一条线"。
// 一个 texel 对一个地面格点（与色流同一张格），按格点 Load 再双线性，寻址口径与读色流完全相同。
// 贴图是 RG32F，这里只取 R（成品）；G 是只糊的场，给材质的浅土路取阈值，草不读。
Texture2D<float> CoverGroundMask;
uint             CoverUseGroundMask;   // 1 = 读地面遮罩；0 = 读色流的原始通道（选了 G/B/A 的物种、或地面还没有遮罩）
// 读地面遮罩前把采样点挪一下（x = 强度 cm，y = 1/波长 cm⁻¹；`CSGroundMaskWarp.ush`）。地面材质按同一个位移采，
// 草线与土边因此一起抖（用户 2026-09-29："交界过于生硬"）。只作用在地面遮罩这条路上。
float2           CoverMaskWarp;

float  CoverChance;                  // 一格出一株的概率（草 ≈ 1，花是稀疏支线）
float  CoverJitter;                  // 落点抖动幅度，格距的比例（0 = 规则网格，1 = 整格）
float  CoverMinSlopeCos;             // 地形法线 .z 的下限：比这更陡的坡不长（岩壁不长草）
float  CoverSink;                    // 根部沉入地表的深度（cm）——浮在地表上会读成"掉了个道具"
// 整个物种的世界 Z 偏移（cm，可正可负），垂直方向唯一的旋钮。
// **基础网格的原点就是落点**：这里刻意**没有**"按包围盒把网格底面钉到地表"那一层
// （石阶的 `StairRise` 有，地被 2026-09-09 起没有）—— 网格离原点多高是作者摆的，花本来
// 就可能有意高出地面，自动坐底会把那个意图抹掉，而且换一张网格就让全片花无声地跳一次高度。
// **不乘高度缩放**：本条表达"整片一起挪这么多厘米"，乘了缩放高的那株就挪得更多，
// 一片花不再落在同一个平面上。
float  CoverHeightOffset;

float2 CoverScaleRange;              // 均匀缩放 [min, max]
float  CoverHeightJitter;            // Z 轴额外抖动（±），只改高矮不改粗细
float  CoverLeanMaxRad;              // 最大倾倒角，**单侧 [0, max]**，整簇共用（见下面的簇朝向）
float  CoverAlignToNormal;           // 0 = 世界上（TG 的草就是世界上），1 = 完全贴地形法线

// --- 簇朝向（照抄 TG `_generate_grass:270-300` + `:391-416`）----------------
//
// TG 的草朝向**不是逐叶随机**，而是一层 2.5 m 的簇结构：叶片先在 3×3 邻域里找最近的
// **抖动站点**（jittered-grid Worley），得到"簇心"与"簇 id"；整簇共用一个朝向与一个倾倒角，
// 逐叶再 slerp 一个纯随机方向进去。丰富感就来自这三层的叠加 ——
// 全随机会读成噪声，全对齐会读成梳过的地毯。
float  CoverClumpSize;               // 簇格边长（cm）。TG = 2.5 单位 = 250 cm
float  CoverClumpRadialChance;       // 整簇"从簇心向外辐射"的概率。TG = 0.30
float  CoverClumpAlignment;          // 簇朝向在 slerp 里的权重上限。TG = 0.5（实际 0.3–0.5）
float  CoverScaleClumpShare;        // 缩放取样有多少来自簇（1 = 完全簇共享）。TG 的高度基准就是簇共享的

// --- 逐实例 custom data（材质侧的 `Per Instance Custom Data` 节点）------------
//
// 地被这一家的语义：**[0] = 弯曲幅度，[1] 保留（恒写 0）**。
// 语义是**逐组件**的 —— 藤蔓那一家在同样的 [0]/[1] 上放 SpawnTime 与弧长，互不干扰。
// 步长 `CS_GPU_INSTANCED_CUSTOM_DATA_FLOATS` 由 C++ 侧 `ModifyCompilationEnvironment` 注入，
// 本文件**不再写第三份常量**（工程里已经有两份，外加 CSHouseVine.usf 的一处硬编码）。
//
// ⚠️ **`[1]` 曾经存"该株的世界高度 cm"，2026-09-07 拆掉了 —— 它是冗余的**：本工厂强制
// `USE_INSTANCING`（`CSGpuInstancedMeshVertexFactory.cpp:28`），因此材质里的 Local→World 走的是
// `Parameters.InstanceLocalToWorld`（`MaterialTemplate.ush:1702-1708`）＝**逐实例**矩阵，于是
// `length(TransformVector(float3(0,0,1), Local→World))` 恰好就是高度缩放（AxisZ 是单位向量，
// actor 只允许平移所以 WorldToComponent 正交），再乘网格局部高度就是世界高度。
// 槽位留空而不是留旧值：**恒写 0** 才能把"这一格没人用"做成可断言的事实。
RWBuffer<float> RWCoverCustomData;
float2 CoverBendRange;              // 弯曲幅度区间，逐叶均匀取样。TG = [0.5, 2.0]
float  CoverRadialBendScale;        // **辐射簇**的弯曲倍率。TG = 0.5（朝外辐射的那 30% 簇更挺）

uint   CoverSeed;                    // 用户种子
uint   CoverSalt;                    // 物种盐：同一格上草与各种花必须掷出不同的数
uint   CoverMaxInstances;            // 固定容量。越界静默丢弃 —— 宁可少长一株也不能踩出 buffer

float3 CoverBaseSphereCentre;        // 基础网格局部包围球（未缩放）
float  CoverBaseSphereRadius;

// --- 房屋环带：建筑周边灌木（照 TG `_garden_spawn_bushes_buildings.cs`）-------------
//
// TG 在模糊后的 `buildings_mask` 边缘环带上撒灌木：建筑内部排除、再过一层 1 m 格的值噪声门槛、
// 尺寸按环带里的位置取一个鼓包。本项目没有建筑 mask，房子把**外皮凸多边形**推给地面
// （`ACSGroundActor::SetBuildingFootprint`），这里逐株求到最近那栋外皮的**有符号距离** ——
// 与模糊 mask 表达的是同一件事（离墙多远），而且精确、不受 mask 分辨率限制。
// `CoverRingWidth ≤ 0` 的物种（草、花）整段跳过，与加这道门控之前逐位相同。
#ifndef CSCOVER_BUILDING_STRIDE
#define CSCOVER_BUILDING_STRIDE 10
#endif
#ifndef CSCOVER_BUILDING_MAX_VERTS
#define CSCOVER_BUILDING_MAX_VERTS 16
#endif
StructuredBuffer<float4> CoverBuildings;   // 每栋 STRIDE 个：[0] = 世界 AABB (minX, minY, maxX, maxY)，[1].x = 顶点数，[2..] = 逆时针凸多边形顶点两个一组
uint   CoverBuildingCount;
float  CoverRingInner;                     // 离外皮多远才开始长（cm），挡住"半棵灌木插进墙里"
float  CoverRingWidth;                     // 环带宽度（cm）；≤ 0 = 不走环带门控
float  CoverRingNoiseCell;                 // 值噪声格距（cm），TG = 1 m
float  CoverRingNoiseThreshold;            // 值噪声门槛，TG = 0.5（约一半的候选被筛掉，成团而不是一圈均匀）
float  CoverRingMinScale;                  // 环带缩放低于它就不长（TG 丢掉环带两头那些太小的）
// 叠加物种：在父物种长了的格子里再抽一次签（TG：30% 的灌木开花，花与本体**同一个变换**）。
// 父子两个物种的全部参数与盐相同 ⇒ 前面每一道判据逐位复现，这里只多一道签。1 = 不抽。
float  CoverOverlayChance;

// --- 聚散（2026-09-29 用户："让花的分布有一些聚散"，参考图 Docs/TinyGlade/img/tiny-glade-ref-flower-clusters-20260929.png）---
//
// 抖动网格从构造上就**不成簇**（文件头那条），草要的正是这个；花在 TG 里却是一片一片的：密的地方花瓣挨着花瓣，
// 其间是只剩零星几朵的空草地。做法是在抖动网格上再叠一道**按位置变化的密度**：三层值噪声 → 分位数 →
// 片内全留、片外只留 `CoverPatchSparse`，片边按 `CoverPatchSoftness` 渐变。抽签用格身份，所以重扫不闪。
// 位置本身仍是抖动网格：片内是"均匀地密"，不会自发扎成一坨一坨的穿模。
// `CoverPatchSize ≤ 0` 的物种（草、灌木）整段跳过，与加这道门控之前逐位相同。
float  CoverPatchSize;               // 成片的特征尺寸（cm）：三层值噪声的底格
float  CoverPatchCoverage;           // 成片区域占地面的比例
float  CoverPatchSoftness;           // 片边过渡在分位数上的宽度（0 = 一刀切）
float  CoverPatchSparse;             // 片外相对片内的密度比例

// 三层值噪声（权重 4/7、2/7、1/7，倍频 2.03）的标准差，离线实测 0.1403（200 万点，分布接近正态）。
// 分位数用正态 CDF 的 logistic 近似 1/(1+e^(−1.702z)) 换算：覆盖比例 0.1 / 0.2 / 0.35 / 0.5 / 0.7 实测
// 0.105 / 0.222 / 0.368 / 0.499 / 0.677。改了噪声的层数或权重就得重测这个数（脚本思路见 Docs/TinyGlade/Ground_Cover.md）。
#define CSCOVER_PATCH_SIGMA 0.1403f

/** 与 CSGpuInstancedMesh.usf:120-126 / CSGroundStairs.usf 同一份哈希的收尾段（uint → [0,1)）。 */
float CSCover_Hash01(uint H)
{
	H = ((H >> ((H >> 28) + 4u)) ^ H) * 277803737u;
	return float((H >> 22 ^ H) & 0xFFFFFFu) / float(0x1000000u);
}

/**
 * 随机源：**格身份**（格坐标 + 物种盐 + 通道盐 + 用户种子）。见文件头那条 ⚠️。
 *
 * 物种盐（`CoverSalt`）不可省：草与花跑的是同一个格、同一份 kernel，盐相同的话
 * "这一格出不出花"与"这一格出不出草"会完全相关 —— 每一朵花的位置上必定也有一株草，
 * 花因此永远长在草心里，看起来像穿模而不是像野花。
 */
uint CSCover_CellSeed(uint2 Cell, uint Channel)
{
	uint H = Cell.x * 0x9E3779B1u;
	H ^= Cell.y * 0x85EBCA77u;
	H ^= Channel * 0x27D4EB2Fu;
	H ^= CoverSalt * 0xC2B2AE3Du;
	H ^= CoverSeed * 0x9E3779B9u;
	return H;
}

/** 色流是 packed BGRA（同 CSMeshOps.usf 的 PackColorBGRA）：B=0..7, G=8..15, R=16..23, A=24..31。 */
float4 CSCover_ReadColor(uint X, uint Y)
{
	const uint Packed = CoverGroundColors[Y * CoverGroundVerts.x + X];
	return float4(
		float((Packed >> 16u) & 0xFFu),
		float((Packed >> 8u) & 0xFFu),
		float(Packed & 0xFFu),
		float((Packed >> 24u) & 0xFFu)) / 255.0f;
}

/**
 * 世界 XY → 地面格双线性的左下角格点与权重；出界返回 false。
 * 色流与地面遮罩是同一张格，共用这一份寻址 —— 两份各写一遍的话，漂掉的那份会让两条路
 * 在路缘错开半格，而两边各自看起来都对。
 */
bool CSCover_GroundBilinear(float2 P, out uint X0, out uint Y0, out float2 F)
{
	X0 = 0u;
	Y0 = 0u;
	F = float2(0.0f, 0.0f);
	if (CoverGroundVerts.x < 2u || CoverGroundVerts.y < 2u) return false;
	const float2 G = (P - CoverGroundOriginXY) / max(CoverGroundCellSize, 1e-3f);
	if (G.x < 0.0f || G.y < 0.0f || G.x > float(CoverGroundVerts.x - 1u) || G.y > float(CoverGroundVerts.y - 1u)) return false;

	X0 = min(uint(floor(G.x)), CoverGroundVerts.x - 2u);
	Y0 = min(uint(floor(G.y)), CoverGroundVerts.y - 2u);
	F = float2(saturate(G.x - float(X0)), saturate(G.y - float(Y0)));
	return true;
}

/**
 * 遮罩的双线性采样：地面遮罩（默认），或色流的原始通道（`CoverUseGroundMask = 0`）。出界返回 0。
 *
 * 出界取 0 而不是"照 BaseColor 补"：地被的格是按地面矩形铺的，理论上不会出界；真出界时
 * （浮点边界）取 0 意味着"没有路" ⇒ 照常长草，比凭空冒出一片秃地安全。
 */
float CSCover_SampleMask(float2 P)
{
	// 扰动的输入是地面局部坐标（与材质的 UV0 × UVWorldPeriod 同一个原点），位移之后再照常寻址。
	if (CoverUseGroundMask != 0u) P += CSGroundMaskWarp_Offset(P - CoverGroundOriginXY, CoverMaskWarp.y, CoverMaskWarp.x);

	uint X0, Y0;
	float2 F;
	if (!CSCover_GroundBilinear(P, X0, Y0, F)) return 0.0f;

	float C00, C10, C01, C11;
	if (CoverUseGroundMask != 0u)
	{
		C00 = CoverGroundMask.Load(int3(X0, Y0, 0));
		C10 = CoverGroundMask.Load(int3(X0 + 1u, Y0, 0));
		C01 = CoverGroundMask.Load(int3(X0, Y0 + 1u, 0));
		C11 = CoverGroundMask.Load(int3(X0 + 1u, Y0 + 1u, 0));
	}
	else
	{
		C00 = dot(CSCover_ReadColor(X0, Y0), CoverMaskChannel);
		C10 = dot(CSCover_ReadColor(X0 + 1u, Y0), CoverMaskChannel);
		C01 = dot(CSCover_ReadColor(X0, Y0 + 1u), CoverMaskChannel);
		C11 = dot(CSCover_ReadColor(X0 + 1u, Y0 + 1u), CoverMaskChannel);
	}
	return lerp(lerp(C00, C10, F.x), lerp(C01, C11, F.x), F.y);
}

/**
 * 水平梯度 ∇h，指向上坡。差分跨距取**地面格距**，与石阶 `CSStairs_GradientXY` 和地面位移
 * pass 的中心差分同形 —— 三处求出来的法线因此互相自洽（换跨距会让"坡度 mask"与"地面看起来
 * 有多陡"对不上，而两边各自都自洽，最难归因）。
 */
float2 CSCover_GradientXY(float2 P)
{
	const float D = max(CoverGroundCellSize, 1e-3f);
	const float Dx = GroundShaperHeightAtXY(P + float2(D, 0.0f)) - GroundShaperHeightAtXY(P - float2(D, 0.0f));
	const float Dy = GroundShaperHeightAtXY(P + float2(0.0f, D)) - GroundShaperHeightAtXY(P - float2(0.0f, D));
	return float2(Dx, Dy) / (2.0f * D);
}

float2 CSCover_BuildingVert(uint Base, uint I)
{
	const float4 Pair = CoverBuildings[Base + 2u + (I >> 1u)];
	return (I & 1u) ? Pair.zw : Pair.xy;
}

/**
 * 到最近那栋房子外皮的**有符号距离**（cm）：外正内负。一栋都够不着时返回一个大数（⇒ 必然落在环带外）。
 *
 * 凸多边形、逆时针 ⇒ 每条边的右手侧是外面。点在里面时"到最近边所在直线的距离"就是精确距离；
 * 在外面时取到各线段的最短距离（角外那一块是到顶点的距离，环带在墙角因此是圆角，同 TG 的模糊 mask）。
 */
float CSCover_BuildingDistance(float2 P)
{
	const float Reach = CoverRingInner + CoverRingWidth;
	float Best = 1e30f;
	for (uint B = 0u; B < CoverBuildingCount; ++B)
	{
		const uint Base = B * CSCOVER_BUILDING_STRIDE;
		const float4 Box = CoverBuildings[Base];
		// 连包围盒都够不着：这栋不可能决定这一株在不在环带里。几十栋房子时绝大多数都在这里退掉。
		const float2 Out = max(max(Box.xy - P, P - Box.zw), 0.0f);
		if (dot(Out, Out) >= Reach * Reach) continue;

		const uint N = min(uint(CoverBuildings[Base + 1u].x), uint(CSCOVER_BUILDING_MAX_VERTS));
		bool bInside = true;
		float Plane = -1e30f;
		float Edge = 1e30f;
		for (uint I = 0u; I < N; ++I)
		{
			const float2 A = CSCover_BuildingVert(Base, I);
			const float2 E = CSCover_BuildingVert(Base, (I + 1u) % N) - A;
			const float L2 = dot(E, E);
			if (L2 < 1e-4f) continue;
			const float S = dot(P - A, float2(E.y, -E.x)) * rsqrt(L2);
			bInside = bInside && S <= 0.0f;
			Plane = max(Plane, S);
			Edge = min(Edge, length(P - (A + E * saturate(dot(P - A, E) / L2))));
		}
		Best = min(Best, bInside ? Plane : Edge);
	}
	return Best;
}

/** 值噪声的格点值。盐里带物种盐 ⇒ 灌木本体与叠加的花读到同一张噪声（它们共用盐，见 CoverOverlayChance）。 */
float CSCover_NoiseLattice(int2 C)
{
	uint H = uint(C.x) * 0x9E3779B1u;
	H ^= uint(C.y) * 0x85EBCA77u;
	H ^= 61u * 0x27D4EB2Fu;
	H ^= CoverSalt * 0xC2B2AE3Du;
	H ^= CoverSeed * 0x9E3779B9u;
	return CSCover_Hash01(H);
}

/** 2D 值噪声，smoothstep 插值（TG 同形：整数格点哈希 + `f²(3 − 2f)`）。用 floor，跨原点不出接缝。 */
float CSCover_ValueNoise(float2 P)
{
	const float2 G = P / max(CoverRingNoiseCell, 1.0f);
	const int2 C = int2(floor(G));
	const float2 F = G - float2(C);
	const float2 W = F * F * (3.0f - 2.0f * F);
	const float V00 = CSCover_NoiseLattice(C);
	const float V10 = CSCover_NoiseLattice(C + int2(1, 0));
	const float V01 = CSCover_NoiseLattice(C + int2(0, 1));
	const float V11 = CSCover_NoiseLattice(C + int2(1, 1));
	return lerp(lerp(V00, V10, W.x), lerp(V01, V11, W.x), W.y);
}

/** 聚散噪声的格点值：通道盐 67 + 层号（与环带噪声的 61 分开），带物种盐 ⇒ 每种花各有各的片。 */
float CSCover_PatchLattice(int2 C, uint Octave)
{
	uint H = uint(C.x) * 0x9E3779B1u;
	H ^= uint(C.y) * 0x85EBCA77u;
	H ^= (67u + Octave) * 0x27D4EB2Fu;
	H ^= CoverSalt * 0xC2B2AE3Du;
	H ^= CoverSeed * 0x9E3779B9u;
	return CSCover_Hash01(H);
}

/** 三层值噪声，约 [0,1]、均值 0.5、标准差 CSCOVER_PATCH_SIGMA。每层错开一个偏移，免得三层的格点叠在原点上。 */
float CSCover_PatchNoise(float2 P)
{
	float2 G = P / max(CoverPatchSize, 1.0f);
	float Sum = 0.0f;
	float Amp = 0.5f;
	float Norm = 0.0f;
	[unroll] for (uint Octave = 0u; Octave < 3u; ++Octave)
	{
		const int2 C = int2(floor(G));
		const float2 F = G - float2(C);
		const float2 W = F * F * (3.0f - 2.0f * F);
		const float V00 = CSCover_PatchLattice(C, Octave);
		const float V10 = CSCover_PatchLattice(C + int2(1, 0), Octave);
		const float V01 = CSCover_PatchLattice(C + int2(0, 1), Octave);
		const float V11 = CSCover_PatchLattice(C + int2(1, 1), Octave);
		Sum += Amp * lerp(lerp(V00, V10, W.x), lerp(V01, V11, W.x), W.y);
		Norm += Amp;
		G = G * 2.03f + float2(17.1f, 31.7f);
		Amp *= 0.5f;
	}
	return Sum / Norm;
}

/**
 * 簇站点：把格坐标 + R2 低差异序列抖动成一个点。R2 常数 `(0.75487, 0.56984)` 与撒叶用的是
 * **同一组**（TG 也是），所以簇的分布与叶的分布同源，不会出现"簇边界正好压在一排叶子上"。
 */
float2 CSCover_ClumpSite(int2 Cell)
{
	// TG 用 `id = cx + cy*577` 把二维格压成一个整数再取 R2 —— 577 是质数，保证相邻格不撞。
	const uint Id = uint(Cell.x + Cell.y * 577) & 0xFFFFu;
	const float2 Jitter = frac(float2(0.75487768650054931640625f, 0.56984031200408935546875f) * float(Id) + 0.5f) - 0.5f;
	// ⚠️ 比 TG 多一个 `+0.5`：TG 的站点以格**角**为心（`cell*2.5 + jitter*2.5`），能伸出本格 1.25；
	// 这里以格**心**为心，站点恒在自己格内 —— 这样 3×3 邻域搜索**保证**能找到真正的最近站点。
	// TG 那种摆法配 3×3 只是"绝大多数情况下对"，边界上会偶尔认错簇（症状是一条格宽的朝向断层）。
	return (float2(Cell) + 0.5f + Jitter) * CoverClumpSize;
}

/** 簇 id → 稳定哈希种子。与叶身份的哈希分开：整簇共用的量必须只由簇身份决定。 */
uint CSCover_ClumpSeed(int2 Cell, uint Channel)
{
	uint H = uint(Cell.x + Cell.y * 577) * 0x9E3779B1u;
	H ^= Channel * 0x27D4EB2Fu;
	H ^= CoverSalt * 0xC2B2AE3Du;
	H ^= CoverSeed * 0x9E3779B9u;
	return H;
}

/**
 * 2D 单位向量 slerp。**必须是 slerp 不是 lerp+normalize**：两个方向接近反向时 lerp 的中间结果
 * 会塌到零向量再被 normalize 放大成噪声，表现是"某些簇的边缘朝向乱跳"。TG 同样走 slerp
 * 并且带同一个退化分支。
 */
float2 CSCover_Slerp2D(float2 A, float2 B, float T)
{
	const float D = dot(A, B);
	// 几乎同向 / 几乎反向：acos 在这里没有可用的精度，直接按权重挑一边（同 TG 的退化分支）。
	if (D > 0.9999f || D < -0.9999f) return (T <= 0.5f) ? A : B;
	const float Omega = acos(D);
	const float S = sin(Omega);
	return (A * sin((1.0f - T) * Omega) + B * sin(T * Omega)) / S;
}

[numthreads(THREADGROUPSIZE_X, THREADGROUPSIZE_Y, 1)]
void ScatterGroundCoverCS(uint3 Id : SV_DispatchThreadID)
{
	if (Id.x >= CoverGridDims.x || Id.y >= CoverGridDims.y) return;

	// 窗口 → 整张网格的格号。整张网格散布时偏移为 0、两个格数相等，这两句逐位等于原来的 `Cell = Id.xy`。
	const int2 GlobalCell = int2(Id.xy) + CoverCellOffset;
	if (GlobalCell.x < 0 || GlobalCell.y < 0 || uint(GlobalCell.x) >= CoverGlobalDims.x || uint(GlobalCell.y) >= CoverGlobalDims.y) return;
	const uint2 Cell = uint2(GlobalCell);

	// 1) 稀疏抽签。**排在最前面**：花的概率可以低到 1%，先抽签能让 99% 的线程在读任何
	//    buffer / 求任何场之前就退掉。草的概率是 1，这一句被编译成恒真，不花钱。
	if (CSCover_Hash01(CSCover_CellSeed(Cell, 3u)) >= CoverChance) return;

	// 2) 落点 = 格心 + 抖动。抖动幅度按格距归一，所以调密度不用重调抖动。
	const float2 CellBase = CoverGridOriginXY + float2(Cell) * CoverCellSize;
	const float Jx = CSCover_Hash01(CSCover_CellSeed(Cell, 11u)) - 0.5f;
	const float Jy = CSCover_Hash01(CSCover_CellSeed(Cell, 13u)) - 0.5f;
	const float2 P = CellBase + (0.5f + CoverJitter * Jx) * float2(CoverCellSize, 0.0f)
	                          + (0.5f + CoverJitter * Jy) * float2(0.0f, CoverCellSize);

	// 2.5) 房屋环带（只有建筑周边灌木走这条）。排在遮罩之前：环带外的格占绝大多数，
	//      在读色流、求高度场之前就该退掉。尺寸鼓包照 TG：环带里 0.4 处最大、两头缩到 0.2 倍。
	float RingScale = 1.0f;
	if (CoverRingWidth > 0.0f)
	{
		const float D = CSCover_BuildingDistance(P);
		if (D <= CoverRingInner || D >= CoverRingInner + CoverRingWidth) return;
		if (CSCover_ValueNoise(P) <= CoverRingNoiseThreshold) return;
		const float T = (D - CoverRingInner) / CoverRingWidth;
		const float Band = saturate(abs(T - 0.4f) / 0.3f);
		const float Bump = 1.0f - Band * Band * (3.0f - 2.0f * Band);
		RingScale = lerp(0.2f, 1.0f, sqrt(Bump));
		if (RingScale < CoverRingMinScale) return;
	}

	// 2.6) 聚散（花）：按位置变化的保留概率，排在遮罩之前 —— 片外那一大半在读遮罩、求高度场之前就退掉。
	if (CoverPatchSize > 0.0f)
	{
		const float Noise = CSCover_PatchNoise(P);
		// 噪声 → 近似分位数（均匀 0..1）：覆盖比例因此就是"多大比例的地面在片里"，不必知道噪声本身的分布。
		const float Quantile = 1.0f / (1.0f + exp(-1.702f * (Noise - 0.5f) / CSCOVER_PATCH_SIGMA));
		const float Edge = 1.0f - CoverPatchCoverage;
		const float Half = 0.5f * CoverPatchSoftness;
		// smoothstep 两端相等时是 0/0：软度为 0 就退成阶跃。
		const float InPatch = Half > 1e-4f ? smoothstep(Edge - Half, Edge + Half, Quantile) : step(Edge, Quantile);
		const float Keep = lerp(CoverPatchSparse, 1.0f, InPatch);
		if (CSCover_Hash01(CSCover_CellSeed(Cell, 59u)) >= Keep) return;
	}

	// 3) 遮罩门控。**用概率拒绝而不是硬阈值**：硬阈值会沿等值线切出一条肉眼可见的直边，
	//    而草的边界在自然界里是"越靠近路越稀"。抽签用的是格身份，所以边界同样是稳定的
	//    （重扫不会让边缘那圈草闪烁）。
	//    读的是**地面遮罩**（处理过的路权重，地面材质混贴图用的也是它）：土露出来的地方草自然稀掉，
	//    草线与土路边是同一张图上的等值线，不会各走各的。
	const float Mask = CSCover_SampleMask(P);
	const float Reject = smoothstep(CoverMaskStart, CoverMaskEnd, Mask);
	if (CSCover_Hash01(CSCover_CellSeed(Cell, 17u)) < Reject) return;

	// 4) 坡度门控：岩壁不长草（TG 用 `rocky_terrain` mask 做同一件事，本项目的岩壳 mask
	//    本来就由坡度决定，所以这里直接判坡度 = 与岩壳同源，不需要再引一张贴图）。
	const float2 Grad = CSCover_GradientXY(P);
	const float3 Normal = normalize(float3(-Grad, 1.0f));
	if (Normal.z < CoverMinSlopeCos) return;

	// 5) 簇：3×3 邻域找最近的抖动站点，得到簇心与簇格坐标（jittered-grid Worley）。
	//    ⚠️ 用 `floor` 而不是 TG 的 `int()` 截断：截断在原点两侧会把 0 那一格算两次，
	//    正负交界处出一条一格宽的接缝。TG 的世界是个不跨原点的圆盘所以看不出来，我们跨。
	const float ClumpCell = max(CoverClumpSize, 1.0f);
	const int2 HomeCell = int2(floor(P / ClumpCell));
	int2 ClumpCellId = HomeCell;
	float2 ClumpSite = CSCover_ClumpSite(HomeCell);
	float ClumpBest = 1e30f;
	[unroll] for (int Cx = -1; Cx <= 1; ++Cx)
	{
		[unroll] for (int Cy = -1; Cy <= 1; ++Cy)
		{
			const int2 Cand = HomeCell + int2(Cx, Cy);
			const float2 Site = CSCover_ClumpSite(Cand);
			const float2 Delta = Site - P;
			const float D2 = dot(Delta, Delta);
			if (D2 < ClumpBest)
			{
				ClumpBest = D2;
				ClumpSite = Site;
				ClumpCellId = Cand;
			}
		}
	}

	// 簇朝向：70% 整簇共用一个随机方位角，30% 从簇心向外辐射（TG 实测的 0.7 分支）。
	// 两条都只由**簇身份**决定 ⇒ 同一簇的叶子共享同一个基准方向，这是"成丛"的来源。
	// 辐射与否整簇一个结论，后面算弯曲幅度还要用它，所以提成变量。
	const bool bRadialClump = CSCover_Hash01(CSCover_ClumpSeed(ClumpCellId, 2u)) < CoverClumpRadialChance;
	float2 ClumpDir;
	if (bRadialClump)
	{
		const float2 Out = P - ClumpSite;
		const float OutLen = length(Out);
		// 叶子正好落在簇心上时没有径向方向可言，退回该簇的随机朝向（而不是留个零向量）。
		float SinR, CosR;
		sincos(CSCover_Hash01(CSCover_ClumpSeed(ClumpCellId, 5u)) * CSCOVER_TWO_PI, SinR, CosR);
		ClumpDir = (OutLen > 1e-3f) ? (Out / OutLen) : float2(CosR, SinR);
	}
	else
	{
		float SinC, CosC;
		sincos(CSCover_Hash01(CSCover_ClumpSeed(ClumpCellId, 5u)) * CSCOVER_TWO_PI, SinC, CosC);
		ClumpDir = float2(CosC, SinC);
	}

	// 逐叶纯随机方向，再按权重 slerp 回簇朝向。TG 的权重是 0.5 − 0.2·rand ∈ [0.3, 0.5]，
	// 这里把上限做成参数、抖动量沿用 TG 的 0.2 —— 参数取默认 0.5 时与 TG 逐位同形。
	float SinB, CosB;
	sincos(CSCover_Hash01(CSCover_CellSeed(Cell, 23u)) * CSCOVER_TWO_PI, SinB, CosB);
	const float2 BladeDir = float2(CosB, SinB);
	const float ClumpWeight = saturate(CoverClumpAlignment - 0.2f * CSCover_Hash01(CSCover_CellSeed(Cell, 43u)));
	// slerp(叶随机, 簇朝向, 簇权重)：权重 0 = 完全逐叶随机，1 = 完全跟簇。
	const float2 Facing = CSCover_Slerp2D(BladeDir, ClumpDir, ClumpWeight);

	// 姿态。+Z 在世界上与地形法线之间插值：TG 的草是**世界上**（`_grass.raster` 的基
	// 第二列写死 `vec3(0,1,0)`），贴坡的是岩壳不是草；但花插在坡上时贴一点法线更自然，
	// 所以留成参数而不是写死。
	float3 AxisZ = normalize(lerp(float3(0.0f, 0.0f, 1.0f), Normal, saturate(CoverAlignToNormal)));

	// ⚠️ **朝向要放在 AxisY 上，不是 AxisX**：基础网格（`SM_TG_GrassBlade`）的弯曲是朝
	// **局部 +Y** 的（顶点 y = 18·t²），而 TG 的叶片弯曲方向与倾倒方向是**同一个方向**
	// （VS 里局部 +Z 既是 bend 轴又是 `_329` 的第三列 = dir）。摆成 AxisX 的话弯曲与倾倒
	// 差 90°，叶子会"朝一边倒、朝另一边弯"——偏航随机时看不出来，成丛之后一眼就是错的。
	float3 AxisY = float3(Facing, 0.0f);
	AxisY = AxisY - AxisZ * dot(AxisY, AxisZ);   // AxisZ 被法线拉歪后要投影回切平面
	const float LenY = length(AxisY);
	AxisY = (LenY > 1e-4f) ? (AxisY / LenY) : normalize(cross(AxisZ, float3(1.0f, 0.0f, 0.0f)));
	float3 AxisX = cross(AxisY, AxisZ);          // 右手系：X = Y × Z

	// 倾倒：绕 AxisX 把 AxisZ 朝 AxisY（= 朝向）转过去，与弯曲同向。
	// **单侧 [0, max] 且整簇共用**（TG 的 `_962 = hash01(簇id 派生) × 0.3`，换算成 0°–27°）——
	// 对称抖动 + 逐叶种子会把成丛效果洗掉，那正是这一轮要修的。
	if (CoverLeanMaxRad > 1e-5f)
	{
		const float Lean = CoverLeanMaxRad * CSCover_Hash01(CSCover_ClumpSeed(ClumpCellId, 29u));
		float SinL, CosL;
		sincos(Lean, SinL, CosL);
		const float3 RotZ = AxisZ * CosL + AxisY * SinL;
		AxisY = AxisY * CosL - AxisZ * SinL;      // 绕 AxisX 的旋转，X 不动、右手系不破
		AxisZ = RotZ;
	}

	// 6) 缩放。均匀缩放定粗细，Z 再单独抖一次定高矮 —— 两者共用一个哈希的话，"高的那株一定
	//    也粗"，一片草会读成"几种尺寸的同一株"而不是"长短不齐的一片"。
	//
	//    取样在**簇**与**逐叶**之间插值：TG 的高度基准是簇共享的（`hash01(簇id*13)*1.5+0.5`），
	//    逐叶只叠一个高斯抖动 —— 所以整簇高矮成片。`CoverScaleClumpShare = 0` 退回纯逐叶，
	//    与加这条之前逐位相同。
	const float ClumpS = CSCover_Hash01(CSCover_ClumpSeed(ClumpCellId, 31u));
	const float BladeS = CSCover_Hash01(CSCover_CellSeed(Cell, 31u));
	// 环带缩放乘在这里：粗细与高矮一起按它缩（草和花的 RingScale 恒为 1）。
	const float Uniform = lerp(CoverScaleRange.x, CoverScaleRange.y, lerp(BladeS, ClumpS, CoverScaleClumpShare)) * RingScale;
	float HeightScale = Uniform * (1.0f + CoverHeightJitter * (CSCover_Hash01(CSCover_CellSeed(Cell, 37u)) * 2.0f - 1.0f));
	// 遮罩压高：TG 在路上把草高乘 (1 − path × 0.7)，路边因此是"矮草过渡"而不是一刀切。
	// 地面遮罩向路外平滑延伸过，所以离路越近越矮（原始路权重一格之内就从 0 到 1，那时这段过渡只有十几厘米）。
	HeightScale *= saturate(1.0f - Mask * CoverMaskShorten);
	if (HeightScale < 1e-4f) return;                    // 压到看不见就干脆不占槽位

	// 弯曲幅度（TG `_945`/`_997`）：逐叶均匀取样 × 辐射簇倍率 × (1 − 遮罩)。
	// **辐射簇更挺**这一条不是装饰：朝外辐射的那 30% 簇如果和别的一样弯，整簇会读成一朵
	// 塌下去的花，而 TG 里它读起来是一丛支棱着的草。路上那一项让残存的草不再弯（同 TG 的 `1 − path`）。
	float BendAmp = lerp(CoverBendRange.x, CoverBendRange.y, CSCover_Hash01(CSCover_CellSeed(Cell, 47u)));
	if (bRadialClump) BendAmp *= CoverRadialBendScale;
	BendAmp *= saturate(1.0f - Mask);

	// 7) 落高。**重新求一次场**而不是复用格角：格距可以比地面格粗，格心的真实地面能差几厘米，
	//    而一株浮空 3 cm 的草是看得出来的（石子那条踩过同一个坑）。
	//    坐底修正跟着高度缩放走 —— 抖了 Z 却不抖 Rise，株底就不再钉在地面上（症状是一部分
	//    浮起来、一部分陷进去，而且只在斜看时看得出，同石阶那条）。
	const float Z = CoverGroundBaseZ + GroundShaperHeightAtXY(P) - CoverSink + CoverHeightOffset;

	// 7.5) 叠加物种再抽一次签（通道盐独占 ⇒ 只可能是父物种那一批格子的子集）。
	if (CoverOverlayChance < 1.0f && CSCover_Hash01(CSCover_CellSeed(Cell, 53u)) >= CoverOverlayChance) return;

	// 8) 领槽位；越界静默丢弃（容量一次性定死、永不重算，这是零回读的代价与保证）。
	uint Slot;
	InterlockedAdd(RWCoverCounter[0], 1u, Slot);
	if (Slot >= CoverMaxInstances) return;

	const float3 LocalX = mul(float4(AxisX, 0.0f), CoverWorldToComponent).xyz * Uniform;
	const float3 LocalY = mul(float4(AxisY, 0.0f), CoverWorldToComponent).xyz * Uniform;
	const float3 LocalZ = mul(float4(AxisZ, 0.0f), CoverWorldToComponent).xyz * HeightScale;
	const float3 Origin = mul(float4(P, Z, 1.0f), CoverWorldToComponent).xyz;

	const uint Row = Slot * CS_GPU_INSTANCED_ROW_FLOAT4S;
	RWCoverInstances[Row + 0u] = float4(LocalX, 0.0f);   // .w 必须是 0：引擎拿它做选中/hitproxy
	RWCoverInstances[Row + 1u] = float4(LocalY, 0.0f);
	RWCoverInstances[Row + 2u] = float4(LocalZ, 0.0f);
	// .w 是顶点工厂读的 PerInstanceRandom（LocalVertexFactory.ush 的 OriginBuffer 契约）。
	// **种子同样必须是格身份**：用槽位的话每一笔落笔全场变色，而这一条不会有任何断言报红。
	//
	// ⚠️ 2026-09-12 核实：这个值**写了但没人读**。地被三个 MI（MI_TG_Grass / MI_TG_Flower /
	//    MI_TG_Lavender）同一个主材质 `M_TG_Grass`，而它的表达式里只有
	//    MaterialExpressionVertexColor 与 MaterialExpressionPerInstanceCustomData，
	//    **没有 MaterialExpressionPerInstanceRandom**。而实例路的顶点色 RGB 是基础网格自带的
	//    那一份、逐实例逐位相同（A 被 ClearPackedColorAlpha 清零）⇒ **每一株的颜色完全一样**。
	//    此前这里写的"材质拿它做逐株色变"是想当然，不是实测。
	//    要逐株色变就在 `M_TG_Grass` 里接上 `PerInstanceRandom + VertexColor.A`
	//    （那条等式的两条路契约见 `CSGpuInstancedMeshComponent.h` 的通道字典），
	//    烘焙路才不会跟着变。
	RWCoverInstances[Row + 3u] = float4(Origin, CSCover_Hash01(CSCover_CellSeed(Cell, 41u)));

	const float3 SphereCentre = Origin
		+ LocalX * CoverBaseSphereCentre.x
		+ LocalY * CoverBaseSphereCentre.y
		+ LocalZ * CoverBaseSphereCentre.z;
	// 剔除球必须包住**变换后**的基础网格：基向量是单位长，按最大轴缩放放大即可。
	// 少放大一点点就会在视锥边缘闪掉实例，而且只在斜看时出现，最难复现。
	const float MaxAxisScale = max(Uniform, HeightScale);
	RWCoverInstances[Row + 4u] = float4(SphereCentre, CoverBaseSphereRadius * max(MaxAxisScale, 1e-3f));

	// 逐实例 custom data。**下标必须是 Slot（源序）**：剔除 pass 负责把它搬到压缩后的槽位
	// （`CSGpuInstancedMesh.usf:236-244`，那里源用 Instance、目标用 Dst）。这里若擅自按别的
	// 序号写，症状是"数值张冠李戴、剔除一变就换一批"，而且没有任何断言会响。
	const uint CustomBase = Slot * CS_GPU_INSTANCED_CUSTOM_DATA_FLOATS;
	RWCoverCustomData[CustomBase + 0u] = BendAmp;
	RWCoverCustomData[CustomBase + 1u] = 0.0f;   // 保留槽位，见上面的 ⚠️
}
