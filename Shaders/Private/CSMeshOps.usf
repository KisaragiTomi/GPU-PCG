// Operators over a UCSMesh resident stream set (FCSMeshResident).
//
// Every kernel here writes the same descriptor-driven buffer set the render base draws
// from — positions, packed tangent basis, UV0, colour, indices, per-triangle material id,
// DrawIndexedIndirect args and the two-uint MeshCounters carrier. The tangent and colour
// streams are packed by CSPackedVertex.ush, shared with every other producer (RoadBuilder,
// vine, boolean, Nanite cut, rock shell), so they all feed the same FLocalVertexFactory draw path.
//
// Positions in the resident set are WORLD space: the render component draws with an
// identity transform, and the scene-extraction and boolean paths already produce world
// space. Operators taking a source in local space bake the transform in here.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"   // GetUnWrappedDispatchThreadId: >65535 groups wrap to 2D

#ifndef THREADGROUPSIZE_X
#define THREADGROUPSIZE_X 64
#endif

// For LBVHFloatFlip, the monotone float->uint transform the world-bounds reduction below
// needs to do atomic min/max on floats. Included rather than copied for the same reason
// MeshBoolean.usf includes this file: an ordering trick that is subtly wrong for negative
// floats is exactly the kind of thing that must have one implementation.
#include "/Plugin/PCGPlugins/Shaders/Private/CSGpuTriangleUtilities.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSPackedVertex.ush"   // Pack/UnpackSnorm8888, Pack/UnpackColorBGRA

// --- destination: the resident stream set -----------------------------------
RWBuffer<float> RW_Positions;    // 3 floats / vertex
RWBuffer<uint>  RW_Tangents;     // 2 packed 8888 SNORM / vertex (TangentX, TangentZ)
RWBuffer<float> RW_TexCoords;    // 2 floats / vertex
RWBuffer<uint>  RW_Colors;       // packed BGRA / vertex (matches RoadBuilder.usf)
RWBuffer<uint>  RW_Indices;
RWBuffer<uint>  RW_MaterialIds;  // 1 uint / triangle
RWBuffer<uint>  RW_IndirectArgs; // DrawIndexedIndirect: 5 uints
RWBuffer<uint>  RW_MeshCounters; // [0] = vertexCount, [1] = indexCount

// Read-only view of the counters, used by append-style operators to find their base offset
// without a CPU round-trip.
Buffer<uint> InMeshCounters;

// --- source: a static mesh's own render buffers ------------------------------
Buffer<uint>   SrcIndexBuffer;
Buffer<float>  SrcPositionBuffer;   // stride SrcPositionStrideFloat
Buffer<float4> SrcTangentBuffer;    // 2 entries / vertex: [0] TangentX, [1] TangentZ(.w = sign)
Buffer<float2> SrcTexCoordBuffer;   // interleaved, SrcNumTexCoords per vertex
Buffer<float4> SrcColorBuffer;      // memory order (B,G,R,A)
Buffer<uint>   SrcTriToMaterial;    // 1 registry id / source triangle

// --- source: a triangle soup (scene extraction / boolean output) -------------
Buffer<float4> SrcSoupVertices;     // xyz world position, w = 1; 3 per triangle
Buffer<float4> SrcSoupNormals;      // xyz world normal, w = 0; 3 per triangle
Buffer<float2> SrcSoupUVs;          // interleaved SrcSoupUVChannels per corner
Buffer<uint>   SrcSoupMaterialIds;  // 1 per triangle
Buffer<uint>   SrcSoupCounter;      // [0] = triangle count

float4x4 SrcLocalToWorld;
float4x4 SrcNormalToWorld;          // inverse-transpose of SrcLocalToWorld, for normals/tangents
float4   ConstantColor;             // RGBA in 0..1

uint SrcVertexCount;
uint SrcIndexCount;
uint SrcTriangleCount;
uint SrcPositionStrideFloat;
uint SrcNumTexCoords;
uint SrcSoupUVChannels;
uint SrcHasTangents;
uint SrcHasColors;
uint MaterialIdOffset;
uint DstVertexBase;
uint DstIndexBase;
uint VertexCapacity;
uint IndexCapacity;
uint bFlipWinding;
uint ThreadCount;

float3 ReadSrcPosition(uint VertexId)
{
	const uint Base = VertexId * SrcPositionStrideFloat;
	return float3(SrcPositionBuffer[Base + 0], SrcPositionBuffer[Base + 1], SrcPositionBuffer[Base + 2]);
}

float3 SafeNormal(float3 N)
{
	const float LenSq = dot(N, N);
	if (!(LenSq > 1e-12f) || any(isnan(N))) return float3(0.0f, 0.0f, 1.0f);
	return N * rsqrt(LenSq);
}

// A tangent perpendicular to N, used whenever the source has none.
float3 ArbitraryTangent(float3 N)
{
	const float3 Helper = (abs(N.z) < 0.99f) ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	return SafeNormal(cross(Helper, N));
}

void WriteVertex(uint V, float3 P, float3 TanX, float4 TanZ, float2 UV, uint PackedColor)
{
	RW_Positions[V * 3 + 0] = P.x;
	RW_Positions[V * 3 + 1] = P.y;
	RW_Positions[V * 3 + 2] = P.z;
	RW_Tangents[V * 2 + 0] = PackSnorm8888(float4(TanX, 0.0f));
	RW_Tangents[V * 2 + 1] = PackSnorm8888(TanZ);
	RW_TexCoords[V * 2 + 0] = UV.x;
	RW_TexCoords[V * 2 + 1] = UV.y;
	RW_Colors[V] = PackedColor;
}

// ---------------------------------------------------------------- counters + indirect args
//
// Every operator that changes the mesh size ends by writing both the MeshCounters carrier and
// the DrawIndexedIndirect args, which is why the render side never has to be told how big the
// mesh is. Uploads know their counts on the CPU (SetCountersCS); GPU-sized operators derive
// them from their own output counter (AdvanceCountersBySoupCS).

// Writes CPU-known counts (uploads) and the args in one pass.
[numthreads(1, 1, 1)]
void SetCountersCS(uint3 Id : SV_DispatchThreadID)
{
	const uint VertexCount = min(DstVertexBase, VertexCapacity);
	const uint IndexCount = min(DstIndexBase, IndexCapacity);
	RW_MeshCounters[0] = VertexCount;
	RW_MeshCounters[1] = IndexCount;
	RW_IndirectArgs[0] = IndexCount;
	RW_IndirectArgs[1] = 1;
	RW_IndirectArgs[2] = 0;
	RW_IndirectArgs[3] = 0;
	RW_IndirectArgs[4] = 0;
}

// ---------------------------------------------------------------- static mesh upload

// One thread per source vertex. Positions are baked to world space here because the
// resident set is world space by contract.
[numthreads(THREADGROUPSIZE_X, 1, 1)]
void UploadStaticMeshVerticesCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (V >= SrcVertexCount) return;

	const uint Dst = DstVertexBase + V;
	if (Dst >= VertexCapacity) return;

	const float3 P = mul(float4(ReadSrcPosition(V), 1.0f), SrcLocalToWorld).xyz;

	float3 N = float3(0.0f, 0.0f, 1.0f);
	float3 T = float3(1.0f, 0.0f, 0.0f);
	float Sign = 1.0f;
	if (SrcHasTangents != 0u)
	{
		const float4 SrcTanX = SrcTangentBuffer[V * 2 + 0];
		const float4 SrcTanZ = SrcTangentBuffer[V * 2 + 1];
		N = SafeNormal(mul(float4(SrcTanZ.xyz, 0.0f), SrcNormalToWorld).xyz);
		T = SafeNormal(mul(float4(SrcTanX.xyz, 0.0f), SrcLocalToWorld).xyz);
		Sign = (SrcTanZ.w < 0.0f) ? -1.0f : 1.0f;
		// Re-orthogonalise: a non-uniform scale skews tangent and normal apart.
		T = SafeNormal(T - N * dot(T, N));
	}
	else
	{
		T = ArbitraryTangent(N);
	}

	float2 UV = float2(0.0f, 0.0f);
	if (SrcNumTexCoords > 0u) UV = SrcTexCoordBuffer[V * SrcNumTexCoords];

	// FColor is stored BGRA, and the destination stream is BGRA too, so the components pass
	// straight through in memory order.
	uint PackedColor = 0xffffffffu;
	if (SrcHasColors != 0u)
	{
		const float4 SrcColor = SrcColorBuffer[V];
		PackedColor = PackColorBGRA(float4(SrcColor.z, SrcColor.y, SrcColor.x, SrcColor.w));
	}

	WriteVertex(Dst, P, T, float4(N, Sign), UV, PackedColor);
}

// One thread per source index. Winding is preserved by default: UE's render index buffer
// already draws the source mesh correctly, and the readback -> MeshDescription path derives
// its face normal from the same convention.
[numthreads(THREADGROUPSIZE_X, 1, 1)]
void UploadStaticMeshIndicesCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint K = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (K >= SrcIndexCount) return;

	const uint Dst = DstIndexBase + K;
	if (Dst >= IndexCapacity) return;

	uint Corner = K % 3u;
	if (bFlipWinding != 0u && Corner != 0u) Corner = 3u - Corner; // swap corners 1 and 2
	const uint SrcK = (K / 3u) * 3u + Corner;

	RW_Indices[Dst] = DstVertexBase + SrcIndexBuffer[SrcK];

	if (Corner == 0u)
	{
		const uint Tri = K / 3u;
		const uint DstTri = (DstIndexBase / 3u) + Tri;
		if (Tri < SrcTriangleCount) RW_MaterialIds[DstTri] = SrcTriToMaterial[Tri] + MaterialIdOffset;
	}
}

// ---------------------------------------------------------------- triangle-soup append

// Appends a world-space triangle soup (the scene extraction / boolean output format) onto
// the end of the resident mesh. The base offset comes from the counters buffer, so no CPU
// round-trip is needed even though only the GPU knows how big the soup turned out.
[numthreads(THREADGROUPSIZE_X, 1, 1)]
void AppendTriangleSoupCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);

	const uint SoupVertexCount = min(SrcSoupCounter[0] * 3u, SrcTriangleCount * 3u);
	if (V >= SoupVertexCount) return;

	const uint BaseVertex = InMeshCounters[0];
	const uint BaseIndex = InMeshCounters[1];
	const uint Dst = BaseVertex + V;
	if (Dst >= VertexCapacity || (BaseIndex + V) >= IndexCapacity) return;

	const float3 P = SrcSoupVertices[V].xyz;
	const float3 N = SafeNormal(SrcSoupNormals[V].xyz);
	const float3 T = ArbitraryTangent(N);

	float2 UV = float2(0.0f, 0.0f);
	if (SrcSoupUVChannels > 0u) UV = SrcSoupUVs[V * SrcSoupUVChannels];

	WriteVertex(Dst, P, T, float4(N, 1.0f), UV, 0xffffffffu);

	// Soup is a triangle list with a unique vertex per corner, so the index buffer is identity.
	RW_Indices[BaseIndex + V] = Dst;

	if ((V % 3u) == 0u)
	{
		const uint SoupTri = V / 3u;
		const uint DstTri = (BaseIndex / 3u) + SoupTri;
		// CS_NO_MATERIAL_ID stays out of range on purpose; the readback maps it to slot 0.
		const uint SrcId = SrcSoupMaterialIds[SoupTri];
		RW_MaterialIds[DstTri] = (SrcId == 0xFFFFFFFFu) ? SrcId : (SrcId + MaterialIdOffset);
	}
}

// Adds the appended soup to the counters. Runs after AppendTriangleSoupCS.
[numthreads(1, 1, 1)]
void AdvanceCountersBySoupCS(uint3 Id : SV_DispatchThreadID)
{
	const uint SoupVertexCount = min(SrcSoupCounter[0] * 3u, SrcTriangleCount * 3u);
	RW_MeshCounters[0] = min(RW_MeshCounters[0] + SoupVertexCount, VertexCapacity);
	RW_MeshCounters[1] = min(RW_MeshCounters[1] + SoupVertexCount, IndexCapacity);

	const uint IndexCount = RW_MeshCounters[1];
	RW_IndirectArgs[0] = IndexCount;
	RW_IndirectArgs[1] = 1;
	RW_IndirectArgs[2] = 0;
	RW_IndirectArgs[3] = 0;
	RW_IndirectArgs[4] = 0;
}

// ---------------------------------------------------------------- in-place vertex ops

// Transforms positions and rotates the tangent basis with them.
[numthreads(THREADGROUPSIZE_X, 1, 1)]
void TransformMeshCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (V >= ThreadCount || V >= InMeshCounters[0]) return;

	const float3 P = float3(RW_Positions[V * 3 + 0], RW_Positions[V * 3 + 1], RW_Positions[V * 3 + 2]);
	const float3 NewP = mul(float4(P, 1.0f), SrcLocalToWorld).xyz;
	RW_Positions[V * 3 + 0] = NewP.x;
	RW_Positions[V * 3 + 1] = NewP.y;
	RW_Positions[V * 3 + 2] = NewP.z;

	// The packed basis has to be unpacked, rotated and repacked; there is no in-place rotate.
	// ⚠️ 解包只能走 UnpackSnorm8888 —— 手写 `(int)((P << 24) >> 24)` 会剥掉符号位，理由与
	// 实测症状见那个函数上面的注释。
	const uint PackedX = RW_Tangents[V * 2 + 0];
	const uint PackedZ = RW_Tangents[V * 2 + 1];
	const float3 TanX = SafeNormal(mul(float4(UnpackSnorm8888(PackedX).xyz, 0.0f), SrcLocalToWorld).xyz);
	const float3 TanZ = SafeNormal(mul(float4(UnpackSnorm8888(PackedZ).xyz, 0.0f), SrcNormalToWorld).xyz);
	const float Sign = (((PackedZ >> 24) & 0xFFu) >= 128u) ? -1.0f : 1.0f;

	RW_Tangents[V * 2 + 0] = PackSnorm8888(float4(SafeNormal(TanX - TanZ * dot(TanX, TanZ)), 0.0f));
	RW_Tangents[V * 2 + 1] = PackSnorm8888(float4(TanZ, Sign));
}

// Swaps corners 1 and 2 of every triangle and negates the stored normal, which is what
// "flip" has to mean when the normal is a vertex attribute rather than a derived quantity.
[numthreads(THREADGROUPSIZE_X, 1, 1)]
void FlipNormalsCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint Tri = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (Tri >= ThreadCount || (Tri * 3u + 2u) >= InMeshCounters[1]) return;

	const uint I1 = RW_Indices[Tri * 3u + 1u];
	const uint I2 = RW_Indices[Tri * 3u + 2u];
	RW_Indices[Tri * 3u + 1u] = I2;
	RW_Indices[Tri * 3u + 2u] = I1;
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void NegateNormalsCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (V >= ThreadCount || V >= InMeshCounters[0]) return;

	const uint PackedZ = RW_Tangents[V * 2 + 1];
	// ⚠️ 同 TransformMeshCS：解包必须走 UnpackSnorm8888，手写移位会剥掉符号位。
	const float3 TanZ = UnpackSnorm8888(PackedZ).xyz;
	const float Sign = (((PackedZ >> 24) & 0xFFu) >= 128u) ? -1.0f : 1.0f;
	RW_Tangents[V * 2 + 1] = PackSnorm8888(float4(-TanZ, -Sign));
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void SetVertexColorsCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (V >= ThreadCount || V >= InMeshCounters[0]) return;
	RW_Colors[V] = PackColorBGRA(ConstantColor);
}

// ---------------------------------------------------------------- sphere colour brush
//
// Reads the resident positions (world space) as an SRV and rewrites only the colour stream.
// The falloff weight and the four blend formulas are a CONTRACT shared with CPU mirrors of
// painted colours (ECSMeshPaintBlendOp in CSMeshOps.h, ACSGroundActor's mirror twin): both
// sides read the same stored 8-bit value, apply the same math, and round back to 8 bits, so
// they cannot drift apart by more than float rounding. Change one, change all three.

Buffer<float> BrushSrcPositions;   // resident position stream, 3 floats / vertex
float4 BrushChannelMask;           // per-channel gate: > 0 = channel is painted
float3 BrushCenter;                // world space
float  BrushRadius;
float  BrushFalloff;               // 0 = hard to the rim, 1 = fade from the centre out
float  BrushStrength;
uint   PaintBlendOp;               // ECSMeshPaintBlendOp: 0 Replace, 1 Add, 2 Max, 3 Erase
uint4  BrushRegion;                // regular-grid vertex rect, inclusive (x0, y0, x1, y1)
uint   BrushGridVertsX;            // 0 = dispatch over the whole mesh (non-grid meshes)
uint   BrushGridVertsY;

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void PaintVertexColorsSphereCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint Thread = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (Thread >= ThreadCount) return;

	// Regional dispatch decodes the thread as a cell of the row-major grid (Id = Y * VertsX + X,
	// the ground mirror's layout — same decode as DisplaceGroundShapersCS). A brush stroke only
	// touches a handful of cells, so this keeps the dispatch off the mesh's total vertex count.
	uint V = Thread;
	if (BrushGridVertsX > 0u)
	{
		const uint RegionW = BrushRegion.z - BrushRegion.x + 1u;
		const uint X = BrushRegion.x + (Thread % RegionW);
		const uint Y = BrushRegion.y + (Thread / RegionW);
		if (X >= BrushGridVertsX || Y >= BrushGridVertsY || Y > BrushRegion.w) return;
		V = Y * BrushGridVertsX + X;
	}
	if (V >= InMeshCounters[0]) return;

	const float3 P = float3(BrushSrcPositions[V * 3 + 0], BrushSrcPositions[V * 3 + 1], BrushSrcPositions[V * 3 + 2]);
	const float Distance = length(P - BrushCenter);
	if (Distance >= BrushRadius) return;

	// Smoothstep from the hard core out to the rim. Falloff 0 makes the core the whole brush.
	const float HardRadius = BrushRadius * (1.0f - BrushFalloff);
	const float T = saturate((BrushRadius - Distance) / max(BrushRadius - HardRadius, 1e-3f));
	const float Weight = T * T * (3.0f - 2.0f * T);

	const float4 E = Weight * BrushStrength * saturate(BrushChannelMask);
	const float4 C = UnpackColorBGRA(RW_Colors[V]);
	float4 Result = C;
	if (PaintBlendOp == 0u) Result = lerp(C, ConstantColor, E);
	else if (PaintBlendOp == 1u) Result = C + ConstantColor * E;
	else if (PaintBlendOp == 2u) Result = max(C, ConstantColor * E);
	else if (PaintBlendOp == 3u) Result = C * (1.0f - E);
	RW_Colors[V] = PackColorBGRA(Result);
}

// ---------------------------------------------------------------- vertex welding
//
// The shared weld facility (CSGpuTriangleUtilities) works on a corner-indexed triangle soup
// and hands back a representative corner per corner. These three kernels are the adapter
// between that and an indexed resident mesh: build the soup view, then rewrite the index
// buffer so co-located corners point at one shared vertex. Attribute merging stays a
// producer decision, exactly as the facility's contract says.

RWStructuredBuffer<float3> RW_WeldSoup;
RWBuffer<uint> RW_WeldTriangleCounter;
Buffer<float>  WeldSrcPositions;
Buffer<uint>   WeldSrcIndices;      // pre-weld copy: reading the live buffer while rewriting it would race
Buffer<uint>   WeldRepresentatives;

[numthreads(1, 1, 1)]
void BuildWeldCounterCS(uint3 Id : SV_DispatchThreadID)
{
	RW_WeldTriangleCounter[0] = min(InMeshCounters[1], IndexCapacity) / 3u;
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void BuildWeldSoupCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint K = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (K >= ThreadCount || K >= InMeshCounters[1]) return;

	const uint V = WeldSrcIndices[K];
	RW_WeldSoup[K] = float3(WeldSrcPositions[V * 3 + 0], WeldSrcPositions[V * 3 + 1], WeldSrcPositions[V * 3 + 2]);
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void RemapIndicesByWeldCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint K = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (K >= ThreadCount || K >= InMeshCounters[1]) return;

	// Corners the weld pass never touched come back as 0xFFFFFFFF and keep their own vertex.
	const uint Rep = WeldRepresentatives[K];
	if (Rep == 0xFFFFFFFFu || Rep >= InMeshCounters[1]) return;
	RW_Indices[K] = WeldSrcIndices[Rep];
}

// ---------------------------------------------------------------- material sections
//
// Counting sort of the triangles by material slot, so each slot's triangles are contiguous in
// the index buffer and one DrawIndexedIndirect arg set can cover each run. Four phases:
//   1. clear the per-slot counters (an RDG clear, not a kernel)
//   2. histogram   - one thread per triangle, InterlockedAdd into its slot
//   3. scan        - one thread, serial exclusive prefix; also emits the arg sets, because this
//                    is the only point where a slot's first triangle and its count are both known
//   4. scatter     - one thread per triangle, InterlockedAdd on a per-slot cursor hands out the
//                    destination
// The slot count is CPU-known (UCSMesh::Materials); the triangle count is not, so every kernel
// bounds itself off MeshCounters like the rest of this file.
//
// The scatter order inside a run is whatever the cursors hand out and therefore not
// reproducible between runs. Nothing downstream depends on it: the draw only needs the run to
// be contiguous.

RWBuffer<uint> RW_SlotCounters;     // per material slot: the histogram
RWBuffer<uint> RW_SlotCursors;      // per material slot: the scatter cursor, seeded by the scan
Buffer<uint>   InSlotCounters;      // read-only view of the histogram, for the scan
Buffer<uint>   SortSrcIndices;      // pre-sort copy: one triangle's destination is another's source
Buffer<uint>   SortSrcMaterialIds;  // pre-sort copy, for the same reason
uint NumMaterialSlots;

// CS_NO_MATERIAL_ID (0xFFFFFFFF, what AppendTriangleSoupCS writes for geometry with no registry
// entry) and any other out-of-range id land in slot 0 — the same fallback the CPU readback
// applies, and the only one that cannot index the counter buffer out of bounds.
uint MaterialSlotForId(uint MaterialId)
{
	return (MaterialId < NumMaterialSlots) ? MaterialId : 0u;
}

uint MaterialSortTriangleCount()
{
	return min(InMeshCounters[1], IndexCapacity) / 3u;
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void HistogramMaterialSlotsCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint Tri = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (Tri >= ThreadCount || Tri >= MaterialSortTriangleCount()) return;

	InterlockedAdd(RW_SlotCounters[MaterialSlotForId(SortSrcMaterialIds[Tri])], 1u);
}

// One thread: slot counts are in the tens, and a parallel scan over them would cost more passes
// than it saves. RW_IndirectArgs is cleared before this pass, so an arg set past NumMaterialSlots
// draws nothing instead of holding the previous section layout's draw.
[numthreads(1, 1, 1)]
void ScanMaterialSlotsCS(uint3 Id : SV_DispatchThreadID)
{
	uint FirstTriangle = 0u;
	[loop] for (uint Slot = 0u; Slot < NumMaterialSlots; ++Slot)
	{
		const uint SlotTriangles = InSlotCounters[Slot];
		RW_SlotCursors[Slot] = FirstTriangle;

		const uint Base = Slot * 5u;
		RW_IndirectArgs[Base + 0u] = SlotTriangles * 3u;  // IndexCountPerInstance
		RW_IndirectArgs[Base + 1u] = 1u;                  // InstanceCount
		RW_IndirectArgs[Base + 2u] = FirstTriangle * 3u;  // StartIndexLocation
		RW_IndirectArgs[Base + 3u] = 0u;                  // BaseVertexLocation (indices are absolute)
		RW_IndirectArgs[Base + 4u] = 0u;                  // StartInstanceLocation

		FirstTriangle += SlotTriangles;
	}
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void ScatterTrianglesByMaterialCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint Tri = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	const uint TriangleCount = MaterialSortTriangleCount();
	if (Tri >= ThreadCount || Tri >= TriangleCount) return;

	const uint Slot = MaterialSlotForId(SortSrcMaterialIds[Tri]);
	uint DstTri = 0u;
	InterlockedAdd(RW_SlotCursors[Slot], 1u, DstTri);
	// Cursors are seeded from the histogram over the same triangles, so this can only fire if the
	// two phases disagreed — and a scatter past the end would corrupt whatever follows.
	if (DstTri >= TriangleCount) return;

	RW_Indices[DstTri * 3u + 0u] = SortSrcIndices[Tri * 3u + 0u];
	RW_Indices[DstTri * 3u + 1u] = SortSrcIndices[Tri * 3u + 1u];
	RW_Indices[DstTri * 3u + 2u] = SortSrcIndices[Tri * 3u + 2u];

	// The resolved slot, not the source id: after the sort the id stream has to agree with the
	// section the triangle now sits in, and an unresolved CS_NO_MATERIAL_ID would not.
	RW_MaterialIds[DstTri] = Slot;
}

// ---------------------------------------------------------------- world-bounds reduction
//
// InterlockedMin/Max only exist for uints, and asuint(float) does not order negative floats —
// their bit patterns run backwards, so a naive atomic min over asuint would report the *least*
// negative coordinate as the minimum. LBVHFloatFlip (CSGpuTriangleUtilities.ush) is the monotone
// transform the LBVH refit already uses for exactly this; the CPU undoes it after the readback.

RWBuffer<uint> RW_MeshBounds;   // [0..2] flipped min xyz, [3..5] flipped max xyz
Buffer<float>  BoundsSrcPositions;

groupshared uint GSBoundsMin[3];
groupshared uint GSBoundsMax[3];

// The min/max identities in the flipped ordering: 0xFFFFFFFF sits above every real float and 0
// below every one, so a group — or a whole mesh — that contributes nothing leaves the result at
// the clear value, which is how the CPU tells "empty" from "a degenerate box at the origin".
[numthreads(1, 1, 1)]
void ClearMeshBoundsCS(uint3 Id : SV_DispatchThreadID)
{
	for (uint Axis = 0u; Axis < 3u; ++Axis)
	{
		RW_MeshBounds[Axis] = 0xFFFFFFFFu;
		RW_MeshBounds[3u + Axis] = 0u;
	}
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void ReduceMeshBoundsCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	// The group reduces into LDS first. Six global atomics per vertex would serialise the entire
	// dispatch on six addresses, and the meshes worth an exact bound are the ones with millions
	// of vertices.
	if (GroupIndex < 3u)
	{
		GSBoundsMin[GroupIndex] = 0xFFFFFFFFu;
		GSBoundsMax[GroupIndex] = 0u;
	}
	GroupMemoryBarrierWithGroupSync();

	// No early return anywhere in this kernel: every thread has to reach both barriers.
	const uint V = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (V < ThreadCount && V < min(InMeshCounters[0], VertexCapacity))
	{
		const float3 P = float3(
			BoundsSrcPositions[V * 3u + 0u], BoundsSrcPositions[V * 3u + 1u], BoundsSrcPositions[V * 3u + 2u]);
		// One NaN flips to an extreme uint and swallows the whole box, which would then be
		// blamed on the geometry rather than on the single bad vertex that caused it.
		if (!any(isnan(P)))
		{
			const uint3 Flipped = uint3(LBVHFloatFlip(P.x), LBVHFloatFlip(P.y), LBVHFloatFlip(P.z));
			InterlockedMin(GSBoundsMin[0], Flipped.x);
			InterlockedMin(GSBoundsMin[1], Flipped.y);
			InterlockedMin(GSBoundsMin[2], Flipped.z);
			InterlockedMax(GSBoundsMax[0], Flipped.x);
			InterlockedMax(GSBoundsMax[1], Flipped.y);
			InterlockedMax(GSBoundsMax[2], Flipped.z);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex < 3u)
	{
		InterlockedMin(RW_MeshBounds[GroupIndex], GSBoundsMin[GroupIndex]);
		InterlockedMax(RW_MeshBounds[3u + GroupIndex], GSBoundsMax[GroupIndex]);
	}
}

// -----------------------------------------------------------------------------
// Ground height-field displacement (TinyGladeHouse D9)
//
// 把一组塑形物（圆盘 + 羽化裙边）的高度场直接写进常驻流：只改位置 Z 与切线，
// 不动计数/索引/材质，所以调用方不需要 AddSetCountersPass / InvalidateSections。
//
// 法线走**解析**中心差分：同一个场在 ±1 格重新求值，而不是读邻居顶点的 RW_Positions ——
// 同一 dispatch 内读邻居写自己是竞态（见 CSMeshOps.cpp 焊接/材质排序两处预拷贝注释）。
// 差分的 clamp 与 ACSGroundActor::BuildSnapshotFromMirror 逐字一致，区域更新与全量
// 重建才会给出同一张法线，边界看不出接缝。
// -----------------------------------------------------------------------------

// 高度场本身（GroundShaperParams / GroundShaperCount / GroundShaperHeightAtXY）搬进了共享
// 头文件：石阶扫描 pass（CSGroundStairs.usf）要在**任意世界 XY** 上求同一个场，两边各抄一份
// 迟早会分叉，而分叉的表现是"石阶浮在坡面上方几厘米"这种不报错、只在裙边中段可见的错位。
#include "/Plugin/PCGPlugins/Shaders/Private/CSGroundShaperField.ush"

float2 GroundOriginXY;    // 格点 (0,0) 的世界 XY
float  GroundCellSize;
float  GroundBaseZ;       // 地面 actor 的世界 Z（镜像高度是相对它的）
uint   GroundVertsX;
uint   GroundVertsY;
uint4  GroundRegion;      // 更新矩形的格点闭区间 (x0, y0, x1, y1)

/** 格点索引版：本 kernel 逐顶点工作，换算一次坐标即可，公式仍是共享的那一份。 */
float GroundShaperHeightAt(uint X, uint Y)
{
	return GroundShaperHeightAtXY(GroundOriginXY + float2(float(X), float(Y)) * GroundCellSize);
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void DisplaceGroundShapersCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint Thread = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUPSIZE_X);
	if (Thread >= ThreadCount) return;

	const uint RegionW = GroundRegion.z - GroundRegion.x + 1u;
	const uint X = GroundRegion.x + (Thread % RegionW);
	const uint Y = GroundRegion.y + (Thread / RegionW);
	if (X >= GroundVertsX || Y >= GroundVertsY || Y > GroundRegion.w) return;

	const uint V = Y * GroundVertsX + X;
	if (V >= InMeshCounters[0]) return;

	RW_Positions[V * 3u + 2u] = GroundBaseZ + GroundShaperHeightAt(X, Y);

	// 中心差分；边界退化为单侧（除数随之变），与 CPU 侧 clamp 写法逐字对应。
	const uint XPrev = X > 0u ? X - 1u : 0u;
	const uint XNext = min(X + 1u, GroundVertsX - 1u);
	const uint YPrev = Y > 0u ? Y - 1u : 0u;
	const uint YNext = min(Y + 1u, GroundVertsY - 1u);
	const float DxSpan = GroundCellSize * float(max(XNext - XPrev, 1u));
	const float DySpan = GroundCellSize * float(max(YNext - YPrev, 1u));
	const float DzDx = (GroundShaperHeightAt(XNext, Y) - GroundShaperHeightAt(XPrev, Y)) / DxSpan;
	const float DzDy = (GroundShaperHeightAt(X, YNext) - GroundShaperHeightAt(X, YPrev)) / DySpan;

	const float3 N = SafeNormal(float3(-DzDx, -DzDy, 1.0f));
	const float3 TanX = SafeNormal(cross(float3(0.0f, 1.0f, 0.0f), N));   // 同 BuildSnapshotFromMirror
	RW_Tangents[V * 2u + 0u] = PackSnorm8888(float4(SafeNormal(TanX - N * dot(TanX, N)), 0.0f));
	RW_Tangents[V * 2u + 1u] = PackSnorm8888(float4(N, 1.0f));
}
